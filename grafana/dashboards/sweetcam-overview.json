          "format": "table",
          "rawSql": "SELECT country AS location, COUNT(*) AS value FROM ip_reputation WHERE country IS NOT NULL AND ip_address NOT IN ('172.18.0.1', '::ffff:172.18.0.1', '127.0.0.1', '::1', 'localhost') GROUP BY country;",
          "refId": "A"
