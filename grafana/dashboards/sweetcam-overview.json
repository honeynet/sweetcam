      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT ip_address AS metric, COUNT(*) AS value FROM service_logs WHERE ip_address IS NOT NULL AND ip_address <> '' AND $__timeFilter(timestamp) GROUP BY ip_address ORDER BY value DESC LIMIT 10;",
