      "targets": [
        {
          "format": "time_series",
          "rawSql": "SELECT NOW() AS time, service AS metric, COUNT(*) AS value FROM service_logs WHERE $__timeFilter(timestamp) GROUP BY service;",
          "refId": "A"
        }
      ]
