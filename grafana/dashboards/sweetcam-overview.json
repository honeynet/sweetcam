    {
      "type": "timeseries",
      "title": "Connection per Protocol Over Time",
      "gridPos": {"x": 0, "y": 36, "w": 24, "h": 8},
      "datasource": {"type": "mysql", "uid": "PF7F25038E8A7BA3D"},
      "targets": [
        {
          "format": "time_series",
          "rawSql": "SELECT UNIX_TIMESTAMP(hour_bucket) AS time_sec, COUNT(*) AS web_connections FROM (SELECT DATE_FORMAT(timestamp, '%Y-%m-%d %H:00:00') AS hour_bucket FROM service_logs WHERE service = 'web' AND $__timeFilter(timestamp)) AS subquery GROUP BY hour_bucket ORDER BY time_sec ASC;",
          "refId": "A"
        },
        {
          "format": "time_series",
          "rawSql": "SELECT UNIX_TIMESTAMP(hour_bucket) AS time_sec, COUNT(*) AS rtsp_connections FROM (SELECT DATE_FORMAT(timestamp, '%Y-%m-%d %H:00:00') AS hour_bucket FROM service_logs WHERE service = 'rtsp' AND $__timeFilter(timestamp)) AS subquery GROUP BY hour_bucket ORDER BY time_sec ASC;",
          "refId": "B"
        },
        {
          "format": "time_series",
          "rawSql": "SELECT UNIX_TIMESTAMP(hour_bucket) AS time_sec, COUNT(*) AS onvif_connections FROM (SELECT DATE_FORMAT(timestamp, '%Y-%m-%d %H:00:00') AS hour_bucket FROM service_logs WHERE service = 'onvif' AND $__timeFilter(timestamp)) AS subquery GROUP BY hour_bucket ORDER BY time_sec ASC;",
          "refId": "C"
        },
        {
          "format": "time_series",
          "rawSql": "SELECT UNIX_TIMESTAMP(hour_bucket) AS time_sec, COUNT(*) AS cowrie_connections FROM (SELECT DATE_FORMAT(timestamp, '%Y-%m-%d %H:00:00') AS hour_bucket FROM service_logs WHERE service = 'cowrie' AND $__timeFilter(timestamp)) AS subquery GROUP BY hour_bucket ORDER BY time_sec ASC;",
          "refId": "D"
        }
      ],
