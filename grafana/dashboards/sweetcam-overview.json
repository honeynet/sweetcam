      "targets": [
        {
          "format": "time_series",
          "rawSql": "SELECT NOW() AS time, brand AS metric, COUNT(*) AS value FROM service_logs WHERE brand IS NOT NULL AND brand NOT IN ('auto', 'test', '8080', 'curl/8.14.1') AND $__timeFilter(timestamp) GROUP BY brand;",
          "refId": "A"
        }
      ]
