      "targets": [
        {
          "format": "time_series",
          "rawSql": "SELECT UNIX_TIMESTAMP(timestamp) AS time_sec, COUNT(*) AS count FROM service_logs WHERE $__timeFilter(timestamp) GROUP BY time_sec ORDER BY time_sec ASC;",
          "refId": "A",
