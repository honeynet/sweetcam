doctype html
html
    head
        meta(charset='UTF-8')
        title Image Viewer
        style.
            body {
                margin: 0;
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                background: #f5f6fa;
                display: flex;
                flex-direction: column;
                height: 100vh;
            }
            .header {
                background: #23262b;
                color: white;
                padding: 15px 30px;
                display: flex;
                justify-content: space-between;
                align-items: center;
            }
            .header h1 {
                margin: 0;
                font-size: 24px;
            }
            .user-section {
                display: flex;
                align-items: center;
                gap: 20px;
            }
            .logout-btn {
                background-color: #EC412D;
                color: white;
                padding: 8px 16px;
                border: none;
                border-radius: 4px;
                cursor: pointer;
                text-decoration: none;
                font-size: 14px;
                transition: background-color 0.3s;
            }
            .logout-btn:hover {
                background-color: #d32f2f;
            }
            .main-content {
                flex: 1;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                padding: 20px;
            }
            .image-container {
                position: relative;
                max-width: 90%;
                max-height: 80%;
                background: white;
                border-radius: 8px;
                box-shadow: 0 4px 20px rgba(0,0,0,0.1);
                overflow: hidden;
            }
            .image-display {
                width: 100%;
                height: 100%;
                display: flex;
                align-items: center;
                justify-content: center;
                min-height: 400px;
            }
            .image-display img {
                max-width: 100%;
                max-height: 100%;
                object-fit: contain;
            }
            .controls {
                position: absolute;
                bottom: 20px;
                left: 50%;
                transform: translateX(-50%);
                display: flex;
                gap: 10px;
                background: rgba(0,0,0,0.7);
                padding: 15px;
                border-radius: 25px;
            }
            .controls button {
                background: #0072ff;
                color: white;
                border: none;
                padding: 12px 16px;
                border-radius: 50%;
                cursor: pointer;
                font-size: 18px;
                width: 45px;
                height: 45px;
                display: flex;
                align-items: center;
                justify-content: center;
                transition: background-color 0.3s;
            }
            .controls button:hover {
                background: #0056b3;
            }
            .controls button:disabled {
                background: #ccc;
                cursor: not-allowed;
            }
            .image-info {
                margin-top: 20px;
                text-align: center;
                color: #666;
            }
            .image-counter {
                font-size: 16px;
                font-weight: bold;
                color: #333;
            }
            .no-images {
                text-align: center;
                color: #666;
                font-size: 18px;
            }
    body
        .header
            h1 Image Viewer
            .user-section
                span Welcome, #{userName}!
                a.logout-btn(href="/logout") Logout
        
        .main-content
            .image-container
                .image-display#imageDisplay
                    .no-images#noImages(style="display: none;") No images found in /webservices/public/images/
                .controls
                    button#prevBtn(type='button') &#x25C0;
                    button#nextBtn(type='button') &#x25B6;
            .image-info
                .image-counter#imageCounter
                div#imageName

        script.
            let currentImageIndex = 0;
            let images = [];
            
            
            async function loadImages() {
                try {
                    const response = await fetch('/api/images');
                    if (response.ok) {
                        images = await response.json();
                        if (images.length > 0) {
                            displayImage(0);
                        } else {
                            document.getElementById('noImages').style.display = 'block';
                        }
                    }
                } catch (error) {
                    console.error('Error loading images:', error);
                    document.getElementById('noImages').style.display = 'block';
                }
            }
            
            
            function displayImage(index) {
                if (images.length === 0) return;
                
                currentImageIndex = index;
                const imageDisplay = document.getElementById('imageDisplay');
                const imageCounter = document.getElementById('imageCounter');
                const imageName = document.getElementById('imageName');
                const prevBtn = document.getElementById('prevBtn');
                const nextBtn = document.getElementById('nextBtn');
                
                
                imageDisplay.innerHTML = '';
                
                
                const img = document.createElement('img');
                img.src = images[index];
                img.alt = `Image ${index + 1}`;
                imageDisplay.appendChild(img);
                
                
                imageCounter.textContent = `${index + 1} of ${images.length}`;
                imageName.textContent = images[index].split('/').pop();
                
                
                prevBtn.disabled = index === 0;
                nextBtn.disabled = index === images.length - 1;
            }
            
            
            document.getElementById('prevBtn').addEventListener('click', () => {
                if (currentImageIndex > 0) {
                    displayImage(currentImageIndex - 1);
                }
            });
            
            document.getElementById('nextBtn').addEventListener('click', () => {
                if (currentImageIndex < images.length - 1) {
                    displayImage(currentImageIndex + 1);
                }
            });
            
            
            document.addEventListener('keydown', (e) => {
                if (e.key === 'ArrowLeft' && currentImageIndex > 0) {
                    displayImage(currentImageIndex - 1);
                } else if (e.key === 'ArrowRight' && currentImageIndex < images.length - 1) {
                    displayImage(currentImageIndex + 1);
                }
            });
            
            
            document.addEventListener('DOMContentLoaded', loadImages);
