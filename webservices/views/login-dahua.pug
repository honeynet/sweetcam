doctype html
html(lang="en")
    head
        meta(charset='UTF-8')
        title= 'Login'
        link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css")
        script(src='https://unpkg.com/axios/dist/axios.min.js')
        script(src='https://code.jquery.com/jquery-3.6.3.min.js')
        style.
            :root {
                --dahua-blue: #0072ff;
                --dahua-dark-blue: #0d2a4c;
                --dahua-background-start: #011e3c;
                --dahua-background-end: #024a8d;
                --text-color: #ffffff;
                --input-bg-color: rgba(255, 255, 255, 0.1);
                --input-border-color: rgba(255, 255, 255, 0.3);
            }
            body {
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                background: linear-gradient(135deg, var(--dahua-background-start), var(--dahua-background-end));
                margin: 0;
                display: flex;
                justify-content: center;
                align-items: center;
                height: 100vh;
                overflow: hidden;
                color: var(--text-color);
            }
            .background-overlay {
                position: absolute;
                top: -50%;
                left: -50%;
                width: 200%;
                height: 200%;
                background-image: url('https://www.transparenttextures.com/patterns/wavy-lines.png');
                opacity: 0.05;
                animation: wave 20s linear infinite;
            }
            @keyframes wave {
                0% { transform: translateX(0) translateY(0); }
                100% { transform: translateX(-500px) translateY(-500px); }
            }
            .login-container {
                position: relative;
                z-index: 1;
                background-color: transparent;
                padding: 40px;
                border-radius: 10px;
                width: 380px;
                text-align: center;
            }
            .login-box {
                background: rgba(13, 42, 76, 0.5);
                border: 1px solid rgba(255, 255, 255, 0.1);
                padding: 40px;
                border-radius: 8px;
                backdrop-filter: blur(10px);
                box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
            }
            .brand-logo {
                max-width: 200px;
            }
            .input-group {
                position: relative;
                margin-bottom: 25px;
            }
            .input-group i {
                position: absolute;
                left: 15px;
                top: 50%;
                transform: translateY(-50%);
                color: var(--input-border-color);
            }
            input[type=text], input[type=password] {
                width: 100%;
                padding: 15px 15px 15px 45px;
                background-color: var(--input-bg-color);
                border: 1px solid var(--input-border-color);
                border-radius: 4px;
                box-sizing: border-box;
                color: var(--text-color);
                font-size: 16px;
            }
            input::placeholder {
                color: rgba(255, 255, 255, 0.7);
            }
            button {
                background-color: var(--dahua-blue);
                color: white;
                padding: 15px 20px;
                margin-top: 10px;
                border: none;
                border-radius: 4px;
                cursor: pointer;
                width: 100%;
                font-size: 18px;
                font-weight: bold;
                transition: background-color 0.3s;
            }
            button:hover {
                background-color: #0056b3;
            }
            .options {
                display: flex;
                justify-content: space-between;
                font-size: 14px;
                margin-top: 15px;
            }
            .options a {
                color: var(--input-border-color);
                text-decoration: none;
            }
            .options a:hover {
                text-decoration: underline;
            }
            .error-message {
                color: #ff4d4d;
                font-size: 14px;
                margin-top: 10px;
                height: 20px;
            }
    body
        .background-overlay
        .login-container
            .login-box
                img.brand-logo(src=config.brandImagePath alt=config.brand)
                div#errorMessage.error-message
                form#loginForm
                    .input-group
                        i.fas.fa-user
                        input(type='text' name='username' placeholder='Username' required)
                    .input-group
                        i.fas.fa-lock
                        input(type='password' name='password' placeholder='Password' required)

                    button(type='submit') Login
                    .options
                        a(href="#") Forgot Password?
                        a(href="#") Register

        script.
            $(document).ready(function() {
                $('#loginForm').submit(function(e) {
                    e.preventDefault();
                    
                    const username = $('input[name="username"]').val();
                    const password = $('input[name="password"]').val();
                    const $errorMessage = $('#errorMessage');

                    axios.post('/login', {
                        username: username,
                        password: password
                    })
                    .then(response => {
                        if (response.data.message === "Login successful") {
                            window.location.href = '/';
                        }
                    })
                    .catch(error => {
                        if (error.response) {
                            let message = 'An unknown error occurred.';
                            if (error.response.status === 404) message = 'Username not found.';
                            if (error.response.status === 401) message = 'Incorrect password.';
                            if (error.response.status === 403) message = 'Too many attempts. Try again later.';
                            
                            $errorMessage.text(message);
                        }
                    });
                });
            }); 
