doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    title Login
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css")
    style.
      body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background: #232a34;
        background: radial-gradient(circle, #232a34 0%, #0e1013 100%);
        margin: 0;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
      }
      .reolink-login-card {
        background:rgb(32, 31, 31);
        border-radius: 12px;
        box-shadow: 0 8px 32px 0 rgba(0,0,0,0.25);
        padding: 0;
        width: 520px;
        min-height: 220px;
        display: flex;
        flex-direction: row;
        align-items: stretch;
        overflow: hidden;
      }
      .reolink-login-left {
        width: 180px;
        background:rgb(32, 31, 31);
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .reolink-login-right {
        flex: 1 1 0;
        padding: 3px 32px 32px 24px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        background:rgb(32, 31, 31);
      }
      .reolink-logo {
        width: 110px;
        height: 110px;
        object-fit: contain;
        background:rgb(32, 31, 31);
        border-radius: 12px;
      }
      .reolink-login-right form {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
      }
      .input-group {
        position: relative;
        margin-bottom: 18px;
        margin-top: 10px;
        width: 260px;
        min-width: 180px;
        max-width: none;
        margin-left: 0;
      }
      .input-group label {
        display: block;
        margin-bottom: 4px;
        color: #b0b8c1;
        text-align: left;
      }
      .input-group i {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        color: #3a4a5a;
        margin-top: 10px;
      }
      input[type=text], input[type=password] {
        width: 260px;
        padding: 11px 11px 11px 38px;
        background-color: rgb(255, 255, 255);
        border: 1px solid #2e3742;
        border-radius: 4px;
        color: #2e3742;
        font-size: 15px;
        display: block;
        margin-left: 0;
      }
      input::placeholder {
        color: #7a8593;
      }
      .stream-type {
        display: flex;
        justify-content: flex-start;
        gap: 18px;
        margin-bottom: 18px;
        color: #b0b8c1;
      }
      .stream-type label {
        font-size: 0.98em;
        cursor: pointer;
      }
      button {
        background-color: #1e90ff;
        color: #fff;
        padding: 11px 0;
        margin-top: 8px;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        width: 310px;
        font-size: 17px;
        font-weight: bold;
        transition: background-color 0.3s;
        display: block;
        text-align: center;
        margin-left: 0;
      }
      button:hover {
        background-color: #1877cc;
      }
      .error-message {
        color: red;
        font-size: 14px;
        margin-top: 10px;
        height: 20px;
        text-align: center;
        font-weight: bold;
        display: block;
      }


  body
    .reolink-login-card
      .reolink-login-left
        img.reolink-logo(src="/brands/login-reolink.png", alt="Reolink Logo")
      .reolink-login-right
        #errorMessage.error-message
        form#loginForm
          .input-group
            label(for="username", style="color:#b0b8c1; margin-right:8px; min-width:70px; display:inline-block;") User Name
            i.fas.fa-user
            input(type="text", name="username", id="username", placeholder="User Name", required)
          .input-group
            label(for="password", style="color:#b0b8c1; margin-right:8px; min-width:70px; display:inline-block;") Password
            i.fas.fa-key
            input(type="password", name="password", id="password", placeholder="Password", required)
          button(type="submit") Login

    script(src="https://code.jquery.com/jquery-3.6.0.min.js")
    script.
      $(document).ready(function() {
        $('#loginForm').submit(function(e) {
          e.preventDefault();
          const username = $('input[name="username"]').val();
          const password = $('input[name="password"]').val();
          const $errorMessage = $('#errorMessage');

          
          $errorMessage.text('');

          
          const isAdminMode = window.location.pathname === '/admin/login' || #{isAdminMode || false};
          const loginUrl = isAdminMode ? '/admin/login' : '/login';
          
          $.ajax({
            url: loginUrl,
            method: 'POST',
            data: {
              username: username,
              password: password
            },
            success: function(response) {
              console.log('Login success:', response);
              if (response.message === "Login successful" || response.message === "Admin login successful") {
                window.location.href = '/';
              } else {
                $errorMessage.text('Login failed - please try again.');
              }
            },
            error: function(xhr, status, error) {
              console.log('Login error:', xhr.status, xhr.responseText);
              let message = 'An unknown error occurred.';
              if (xhr.status === 404) message = 'User not found.';
              if (xhr.status === 401) message = 'Wrong password.';
              if (xhr.status === 403) message = 'Too many attempts. Try again later.';
              $errorMessage.text(message);
              console.log('Error displayed:', message);
            }
          });
        });
        
        
        $('input[name="username"], input[name="password"]').on('input', function() {
          $('#errorMessage').text('');
        });
      });
