doctype html
html
    head
        meta(charset='UTF-8')
        title= __('login.resetPassword')
        script(src='https://code.jquery.com/jquery-3.6.0.min.js')
        script(src='https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js')
        style.
            body {
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                background: #011e3c;
                margin: 0;
                display: flex;
                justify-content: center;
                align-items: center;
                height: 100vh;
                color: #fff;
            }
            .reset-container {
                background: rgba(13, 42, 76, 0.8);
                padding: 40px;
                border-radius: 8px;
                width: 400px;
                backdrop-filter: blur(10px);
                border: 1px solid rgba(255, 255, 255, 0.1);
            }
            .brand-logo {
                max-width: 150px;
                margin-bottom: 30px;
            }
            h2 {
                font-size: 1.2em;
                margin-bottom: 20px;
                text-align: center;
            }
            .form-group {
                margin-bottom: 20px;
            }
            .form-group label {
                display: block;
                font-size: 14px;
                margin-bottom: 8px;
                color: rgba(255, 255, 255, 0.7);
            }
            .form-group input {
                width: 100%;
                padding: 12px;
                background: rgba(255, 255, 255, 0.1);
                border: 1px solid rgba(255, 255, 255, 0.3);
                border-radius: 4px;
                color: #fff;
                box-sizing: border-box;
            }
            .reset-btn {
                background: #0072ff;
                color: white;
                padding: 12px;
                border: none;
                border-radius: 4px;
                cursor: pointer;
                width: 100%;
                font-size: 16px;
                font-weight: bold;
                transition: background 0.3s;
            }
            .reset-btn:hover {
                background: #0056b3;
            }
            .message {
                margin-top: 15px;
                font-size: 14px;
                text-align: center;
                display: none;
            }
            .success { color: #4caf50; }
            .error { color: #f44336; }
            .back-link {
                display: block;
                margin-top: 20px;
                text-align: center;
                font-size: 14px;
                color: rgba(255, 255, 255, 0.5);
                text-decoration: none;
            }
    body
        .reset-container
            img.brand-logo(src=config.brandImagePath alt=config.brand)
            h2= __('login.resetPassword')
            form#resetForm
                .form-group
                    label(for="username")= __('login.username')
                    input(type="text" id="username" name="username" required)
                .form-group
                    label(for="q1") Security Question 1: What is your mother's maiden name?
                    input(type="text" id="q1" name="q1" required)
                .form-group
                    label(for="q2") Security Question 2: What was the name of your first pet?
                    input(type="text" id="q2" name="q2" required)
                button.reset-btn(type="submit")= __('login.resetPassword')
            #message.message
            a.back-link(href="/login") Back to Login
        script.
            $(document).ready(function() {
                $('#resetForm').submit(function(e) {
                    e.preventDefault();
                    const payload = {
                        username: $('#username').val(),
                        answers: [$('#q1').val(), $('#q2').val()],
                        brand: 'dahua'
                    };
                    const $message = $('#message');
                    
                    $('.reset-btn').prop('disabled', true).text('Verifying...');
                    
                    axios.post('/forgot-password', payload)
                    .then(response => {
                        $message.text('Security questions verified. A password reset link has been sent to your registered email address.').removeClass('error').addClass('success').show();
                    })
                    .catch(error => {
                        $message.text('Verification failed. Answers did not match our records.').removeClass('success').addClass('error').show();
                    })
                    .finally(() => {
                        $('.reset-btn').prop('disabled', false).text('Reset Password');
                    });
                });
            });
