doctype html
html
    head
        meta(charset='UTF-8')
        title Login - Forgot Password
        script(src='https://code.jquery.com/jquery-3.6.0.min.js')
        script(src='https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js')
        style.
            body {
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                background: #0e1013;
                margin: 0;
                display: flex;
                justify-content: center;
                align-items: center;
                height: 100vh;
                color: #b0b8c1;
            }
            .reset-container {
                background: rgb(32, 31, 31);
                padding: 40px;
                border-radius: 12px;
                width: 400px;
                box-shadow: 0 8px 32px 0 rgba(0,0,0,0.25);
            }
            .brand-logo {
                width: 100px;
                margin-bottom: 20px;
            }
            h2 {
                color: #fff;
                font-size: 1.5em;
                margin-bottom: 20px;
            }
            p {
                font-size: 14px;
                margin-bottom: 24px;
                color: #b0b8c1;
            }
            .form-group {
                margin-bottom: 20px;
                text-align: left;
            }
            .form-group label {
                display: block;
                font-size: 14px;
                margin-bottom: 8px;
            }
            input[type=email] {
                width: 100%;
                padding: 12px;
                background: #fff;
                border: 1px solid #2e3742;
                border-radius: 4px;
                color: #2e3742;
                box-sizing: border-box;
            }
            button {
                background-color: #1e90ff;
                color: #fff;
                padding: 12px;
                border: none;
                border-radius: 4px;
                cursor: pointer;
                width: 100%;
                font-size: 16px;
                font-weight: bold;
                transition: background 0.3s;
            }
            button:hover {
                background-color: #1877cc;
            }
            .message {
                margin-top: 15px;
                font-size: 14px;
                text-align: center;
                display: none;
            }
            .success { color: #1e90ff; }
            .error { color: #ff4444; }
            .back-link {
                display: block;
                margin-top: 20px;
                text-align: center;
                font-size: 14px;
                color: #b0b8c1;
                text-decoration: none;
            }
    body
        .reset-container
            img.brand-logo(src="/brands/login-reolink.png" alt="Reolink Logo")
            h2= __('login.resetPassword')
            p Please enter your registered email address to receive a password reset link.
            form#resetForm
                .form-group
                    label(for="email")= __('login.enterEmail')
                    input(type="email" id="email" name="email" required)
                button(type="submit") Send Reset Link
            #message.message
            a.back-link(href="/login") Back to Login
        script.
            $(document).ready(function() {
                $('#resetForm').submit(function(e) {
                    e.preventDefault();
                    const payload = {
                        email: $('#email').val(),
                        brand: 'reolink'
                    };
                    const $message = $('#message');
                    
                    $('button').prop('disabled', true).text('Sending...');
                    
                    axios.post('/forgot-password', payload)
                    .then(response => {
                        $message.text('Reset link sent! Please check your inbox (and spam folder) for further instructions.').removeClass('error').addClass('success').show();
                    })
                    .catch(error => {
                        $message.text('Error sending reset link. Please try again later.').removeClass('success').addClass('error').show();
                    })
                    .finally(() => {
                        $('button').prop('disabled', false).text('Send Reset Link');
                    });
                });
            });
