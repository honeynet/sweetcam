doctype html
html
    head
        meta(charset='UTF-8')
        title= __('login.resetPassword')
        script(src='https://code.jquery.com/jquery-3.6.0.min.js')
        script(src='https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js')
        style.
            body {
                margin: 0;
                padding: 0;
                font-family: Arial, sans-serif;
                background: #f4f4f4;
                display: flex;
                align-items: center;
                justify-content: center;
                min-height: 100vh;
            }
            .reset-container {
                background: #fff;
                border-radius: 6px;
                box-shadow: 0 2px 8px rgba(0,0,0,0.08);
                padding: 36px 32px;
                width: 400px;
                border-top: 3px solid #d32f2f;
            }
            .hikvision-logo {
                width: 120px;
                margin-bottom: 20px;
            }
            h2 {
                color: #333;
                font-size: 1.2em;
                margin-bottom: 20px;
            }
            p {
                font-size: 14px;
                color: #666;
                line-height: 1.5;
                margin-bottom: 20px;
            }
            .form-group {
                margin-bottom: 18px;
            }
            .form-group label {
                display: block;
                font-size: 14px;
                color: #444;
                margin-bottom: 8px;
            }
            .form-group input {
                width: 100%;
                padding: 10px;
                border: 1px solid #ddd;
                border-radius: 4px;
                box-sizing: border-box;
            }
            .reset-btn {
                background-color: #d32f2f;
                color: white;
                padding: 12px 0;
                border: none;
                border-radius: 4px;
                cursor: pointer;
                width: 100%;
                font-size: 16px;
                transition: background 0.2s;
            }
            .reset-btn:hover {
                background: #b71c1c;
            }
            .message {
                margin-top: 15px;
                font-size: 14px;
                text-align: center;
                display: none;
            }
            .success { color: green; }
            .error { color: red; }
            .back-link {
                display: block;
                margin-top: 20px;
                text-align: center;
                font-size: 14px;
                color: #666;
                text-decoration: none;
            }
    body
        .reset-container
            img.hikvision-logo(src=config.brandImagePath alt='Hikvision Logo')
            h2= __('login.resetPassword')
            p To reset your password, please export the GUID file and send it to our technical support, or enter the security code provided by the support team.
            form#resetForm
                .form-group
                    label(for="username")= __('login.username')
                    input(type="text" id="username" name="username" required)
                .form-group
                    label(for="securityCode")= __('login.securityCode')
                    input(type="text" id="securityCode" name="securityCode" placeholder="Enter code from support" required)
                button.reset-btn(type="submit")= __('login.resetPassword')
            #message.message
            a.back-link(href="/login") Back to Login
        script.
            $(document).ready(function() {
                $('#resetForm').submit(function(e) {
                    e.preventDefault();
                    const username = $('#username').val();
                    const securityCode = $('#securityCode').val();
                    const $message = $('#message');
                    
                    $('.reset-btn').prop('disabled', true).text('Processing...');
                    
                    axios.post('/forgot-password', {
                        username: username,
                        securityCode: securityCode,
                        brand: 'hikvision'
                    })
                    .then(response => {
                        $message.text('Security code verified. You will receive a temporary password via email shortly.').removeClass('error').addClass('success').show();
                    })
                    .catch(error => {
                        $message.text('Invalid security code. Please contact technical support.').removeClass('success').addClass('error').show();
                    })
                    .finally(() => {
                        $('.reset-btn').prop('disabled', false).text('Reset Password');
                    });
                });
            });
