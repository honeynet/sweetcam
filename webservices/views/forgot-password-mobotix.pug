doctype html
html
    head
        meta(charset='UTF-8')
        title= __('login.resetPassword')
        script(src='https://code.jquery.com/jquery-3.6.0.min.js')
        script(src='https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js')
        style.
            body {
                font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
                background-color: #ffffff;
                margin: 0;
                display: flex;
                justify-content: center;
                align-items: center;
                height: 100vh;
            }
            .reset-container {
                width: 400px;
                text-align: center;
                padding: 40px;
                border: 1px solid #eee;
                border-radius: 8px;
            }
            .brand-logo {
                max-width: 300px;
                margin-bottom: 30px;
            }
            h2 {
                font-weight: 300;
                color: #333;
                margin-bottom: 20px;
            }
            p {
                font-size: 14px;
                color: #666;
                text-align: left;
                margin-bottom: 24px;
            }
            .form-group {
                margin-bottom: 20px;
                text-align: left;
            }
            .form-group label {
                display: block;
                font-size: 14px;
                margin-bottom: 6px;
            }
            input[type=text] {
                width: 100%;
                padding: 10px;
                border: 1px solid #ccc;
                border-radius: 4px;
                box-sizing: border-box;
                background: #f5f5f5;
            }
            button {
                background-color: #003366;
                color: white;
                padding: 12px;
                border: none;
                border-radius: 4px;
                cursor: pointer;
                width: 100%;
                font-size: 16px;
                font-weight: bold;
            }
            .message {
                margin-top: 15px;
                font-size: 14px;
                text-align: center;
                display: none;
            }
            .success { color: #003366; font-weight: bold; }
            .error { color: red; }
            .back-link {
                display: block;
                margin-top: 20px;
                text-align: center;
                font-size: 14px;
                color: #003366;
                text-decoration: none;
            }
    body
        .reset-container
            img.brand-logo(src=config.brandImagePath alt=config.brand)
            h2= __('login.resetPassword')
            p To request a factory reset code, please enter the camera's MAC address and your registered administrator username.
            form#resetForm
                .form-group
                    label(for="username")= __('login.username')
                    input(type="text" id="username" name="username" required)
                .form-group
                    label(for="mac") MAC Address
                    input(type="text" id="mac" name="mac" placeholder="e.g. 00:03:c5:xx:xx:xx" required)
                button(type="submit") Generate Reset Code
            #message.message
            a.back-link(href="/login") Back to Login
        script.
            $(document).ready(function() {
                $('#resetForm').submit(function(e) {
                    e.preventDefault();
                    const payload = {
                        username: $('#username').val(),
                        mac: $('#mac').val(),
                        brand: 'mobotix'
                    };
                    const $message = $('#message');
                    
                    $('button').prop('disabled', true).text('Generating...');
                    
                    axios.post('/forgot-password', payload)
                    .then(response => {
                        $message.text('Request submitted. A signed factory reset code will be sent to the technical contact person for this MAC address.').removeClass('error').addClass('success').show();
                    })
                    .catch(error => {
                        $message.text('Error submitting request. Please verify the MAC address and try again.').removeClass('success').addClass('error').show();
                    })
                    .finally(() => {
                        $('button').prop('disabled', false).text('Generate Reset Code');
                    });
                });
            });
