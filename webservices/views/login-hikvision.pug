doctype html
html
    head
        meta(charset='UTF-8')
        title= __('login.title')
        script(src='https://unpkg.com/axios/dist/axios.min.js')
        script(src='https://code.jquery.com/jquery-3.6.3.min.js')
        style.
            body {
                margin: 0;
                padding: 0;
                font-family: Arial, sans-serif;
                min-height: 100vh;
                width: 100vw;
                overflow: hidden;
            }
            .background {
                position: fixed;
                top: 0;
                left: 0;
                width: 100vw;
                height: 100vh;
                z-index: 0;
                background: url('/brands/hikvision-background.png') no-repeat center center;
                background-size: cover;
                filter: none;
            }
            .hikvision-logo {
                position: absolute;
                top: 28px;
                left: 36px;
                z-index: 2;
                width: 140px;
                height: auto;
            }
            .language-chooser {
                position: absolute;
                top: 24px;
                right: 150px;
                z-index: 2;
            }
            .lang-select {
                padding: 2px 8px;
                font-size: 14px;
                border: 1px solid #aaa;
                border-radius: 2px;
                background: #fff;
                color: #222;
                cursor: pointer;
                outline: none;
                position: absolute;
            }
            .login-bg {
                position: relative;
                width: 100vw;
                height: 100vh;
                display: flex;
                align-items: center;
                justify-content: flex-end;
                z-index: 1;
            }
            .login-panel {
                display: flex;
                align-items: center;
                justify-content: flex-end;
                height: 100vh;
                width: 100vw;
                background: none;
            }
            .login-container {
                background: #fff;
                border-radius: 6px;
                box-shadow: 0 2px 8px rgba(0,0,0,0.08);
                padding: 36px 32px 32px 32px;
                width: 350px;
                min-height: 200px;
                margin-right: 60px;
                display: flex;
                flex-direction: column;
                align-items: center;
                border-top: 3px solid #d32f2f;
                z-index: 2;
            }
            .login-container form {
                width: 100%;
            }
            .form-group {
                margin-bottom: 18px;
                position: relative;
            }
            .form-group input {
                width: 100%;
                padding: 12px 12px 12px 38px;
                border: 1px solid #ddd;
                border-radius: 4px;
                font-size: 15px;
                background: #fff;
                box-sizing: border-box;
            }
            .form-group i {
                position: absolute;
                left: 12px;
                top: 50%;
                transform: translateY(-50%);
                color: #bdbdbd;
                font-size: 16px;
            }
            .login-btn {
                background-color: #d32f2f;
                color: white;
                padding: 14px 0;
                border: none;
                border-radius: 4px;
                cursor: pointer;
                width: 100%;
                font-size: 17px;
                margin-top: 10px;
                margin-bottom: 0;
                transition: background 0.2s;
            }
            .login-btn:hover {
                background: #b71c1c;
            }
            .error-message {
                color: red;
                font-size: 13px;
                margin-top: 5px;
                display: none;
            }
        link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css")
    body
        .background
        img.hikvision-logo(src=config.brandImagePath alt='Hikvision Logo')
        .language-chooser
            select.lang-select(name='language' onchange='changeLanguage(this.value)')
                option(value='en' selected=locale === 'en')= __('language.english')
                option(value='es' selected=locale === 'es')= __('language.spanish')
        .login-bg
            .login-panel
                .login-container
                    form#loginForm
                        .form-group
                            i.fas.fa-user
                            input(type='text' name='username' placeholder=__('login.username') required)
                            span#usernameErrorMessage.error-message= __('login.usernameError')
                        .form-group
                            i.fas.fa-lock
                            input(type='password' name='password' placeholder=__('login.password') required)
                            span#passwordErrorMessage.error-message= __('login.passwordError')
                            span#rateErrorMessage.error-message= __('login.rateError')
                        button.login-btn(type='submit')= __('login.loginButton')
        script.
            // Language switching function
            function changeLanguage(lang) {
                window.location.href = '/set-language/' + lang;
            }

            $(document).ready(function() {
                $('#loginForm').submit(function(e) {
                    e.preventDefault();
                    
                    const username = $('input[name="username"]').val();
                    const password = $('input[name="password"]').val();
                    
                    axios.post('/login', {
                        username: username,
                        password: password
                    })
                    .then(response => {
                        if (response.data.message === "Login successful") {
                            window.location.href = '/';
                        }
                    })
                    .catch(error => {
                        if (error.response) {
                            const errorElement = 
                                error.response.status === 404 ? '#usernameErrorMessage' :
                                error.response.status === 401 ? '#passwordErrorMessage' :
                                '#rateErrorMessage';
                            
                            $(errorElement).show().delay(3000).fadeOut();
                        }
                    });
                });
            });
