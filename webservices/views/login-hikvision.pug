doctype html
html
    head
        meta(charset='UTF-8')
        title= 'Login'
        script(src='https://unpkg.com/axios/dist/axios.min.js')
        script(src='https://code.jquery.com/jquery-3.6.3.min.js')
        style.
            body {
                font-family: Arial, sans-serif;
                background-color: #f4f4f4;
                margin: 0;
                padding: 0;
                display: flex;
                justify-content: center;
                align-items: center;
                height: 100vh;
            }
            .login-container {
                background-color: white;
                padding: 30px;
                border-radius: 8px;
                box-shadow: 0 0 10px rgba(0,0,0,0.1);
                width: 350px;
                text-align: center;
            }
            .brand-logo {
                max-width: 70%; 
            }
            input[type=text], input[type=password] {
                width: 100%;
                padding: 12px;
                margin: 8px 0;
                border: 1px solid #ddd;
                border-radius: 4px;
                box-sizing: border-box;
            }
            button {
                background-color: #EC412D;
                color: white;
                padding: 14px 20px;
                margin: 15px 0;
                border: none;
                border-radius: 4px;
                cursor: pointer;
                width: 100%;
                font-size: 16px;
            }
            button:hover {
                opacity: 0.9;
            }
            .error-message {
                color: red;
                font-size: 13px;
                margin-top: 5px;
                display: none;
            }
    body
        .login-container
            img.brand-logo(src=config.brandImagePath alt=config.brand)
            form#loginForm
                .form-group
                    input(type='text' name='username' placeholder='Username' required)
                    span#usernameErrorMessage.error-message Username not found
                .form-group
                    input(type='password' name='password' placeholder='Password' required)
                    span#passwordErrorMessage.error-message Wrong password
                    span#rateErrorMessage.error-message Too many attempts, try again later
                button(type='submit') Login

        script.
            $(document).ready(function() {
                $('#loginForm').submit(function(e) {
                    e.preventDefault();
                    
                    const username = $('input[name="username"]').val();
                    const password = $('input[name="password"]').val();
                    
                    axios.post('/login', {
                        username: username,
                        password: password
                    })
                    .then(response => {
                        if (response.data.message === "Login successful") {
                            window.location.href = '/';
                        }
                    })
                    .catch(error => {
                        if (error.response) {
                            const errorElement = 
                                error.response.status === 404 ? '#usernameErrorMessage' :
                                error.response.status === 401 ? '#passwordErrorMessage' :
                                '#rateErrorMessage';
                            
                            $(errorElement).show().delay(3000).fadeOut();
                        }
                    });
                });
            });
