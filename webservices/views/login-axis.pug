doctype html
html(lang="en")
  head
    meta(charset='UTF-8')
    title= 'Login'
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css")
    script(src='https://code.jquery.com/jquery-3.6.0.min.js')
    style.
      :root {
        --axis-yellow: #ffcc00;
        --axis-gray: #f5f5f5;
        --input-bg: #fff;
        --input-border: #ccc;
        --text-color: #222;
      }
      body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background: linear-gradient(135deg, #fffbe6, var(--axis-gray));
        margin: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        min-height: 100vh;
        color: var(--text-color);
      }
      .axis-header {
        width: 100vw;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        align-items: center;
        margin-top: 32px;
        margin-bottom: 24px;
      }
      .axis-header .brand-logo {
        max-width: 160px;
        margin-bottom: 8px;
      }
      .axis-header .camera-title {
        font-size: 1.2em;
        color: #222;
        font-weight: 600;
        letter-spacing: 0.5px;
      }
      .login-card {
        margin-top: 100px;
        background: transparent;
        margin-bottom: 50px;
        width: 300px;
        padding: 24px 18px 18px 18px;
      }
      .login-card h1 {
        font-size: 2.2em;
        font-weight: 700;
        margin-bottom: 10px;
        color: #444;
      }
      .login-card .subtitle {
        color: #888;
        font-size: 1em;
        margin-bottom: 24px;
      }
      .input-group {
        position: relative;
        margin-bottom: 25px;
      }
      .input-group i {
        position: absolute;
        left: 15px;
        top: 50%;
        transform: translateY(-50%);
        color: #bbb;
      }
      input[type=text], input[type=password] {
        width: 100%;
        padding: 15px 15px 15px 45px;
        background-color: var(--input-bg);
        border: 1px solid var(--input-border);
        border-radius: 4px;
        box-sizing: border-box;
        color: var(--text-color);
        font-size: 16px;
      }
      input::placeholder {
        color: #aaa;
      }
      select {
        width: 100%;
        padding: 12px 10px;
        border-radius: 4px;
        border: 1px solid var(--input-border);
        margin-bottom: 18px;
        font-size: 15px;
        color: #444;
        background: #fff;
      }
      button {
        background-color: var(--axis-yellow);
        color: #222;
        padding: 15px 20px;
        margin-top: 10px;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        width: 100%;
        font-size: 18px;
        font-weight: bold;
        transition: background-color 0.3s;
      }
      button:hover {
        background-color: #e6b800;
      }
      .options {
        display: flex;
        justify-content: space-between;
        font-size: 14px;
        margin-top: 15px;
      }
      .options a {
        color: #888;
        text-decoration: none;
      }
      .options a:hover {
        text-decoration: underline;
      }
      .error-message {
        color: red;
        font-size: 14px;
        margin-top: 10px;
        height: 20px;
        text-align: center;
        font-weight: bold;
        display: block;
      }
      .checkbox-row {
        display: flex;
        align-items: center;
        margin-bottom: 12px;
      }
      .checkbox-row input[type=checkbox] {
        margin-right: 8px;
      }
      .axis-yellow-link {
        color: var(--axis-yellow);
        text-decoration: underline;
        cursor: pointer;
      }
      .axis-login-topbar {
        width: 100vw;
        display: flex;
        align-items: center;
        background: #fff;
        padding: 8px 18px;
        box-sizing: border-box;
        position: fixed;
        top: 0;
        left: 0;
        z-index: 10;
        border-bottom: 3px solid var(--axis-yellow);
        gap: 12px;
        min-height: 38px;
        justify-content: space-between;
      }
      .axis-login-topbar .brand-logo {
        max-width: 80px;
        margin-bottom: 0;
      }
      .axis-login-topbar .camera-title {
        font-size: 1em;
        color: #222;
        font-weight: 600;
        letter-spacing: 0.5px;
        flex: 1;
        text-align: center;
      }
      .lang-select-container {
        position: relative;
        display: inline-block;
        min-width: 100px;
      }
      .lang-select {
        appearance: none;
        background: transparent;
        border: 1px solid #ddd;
        border-radius: 4px;
        font-size: 14px;
        color: #444;
        padding: 6px 30px 6px 12px;
        cursor: pointer;
        width: 100%;
        min-width: 100px;
        background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http:
        background-repeat: no-repeat;
        background-position: right 8px center;
        background-size: 16px;
      }
      .lang-select:focus {
        outline: none;
        border-color: var(--axis-yellow);
        box-shadow: 0 0 0 2px rgba(255, 204, 0, 0.2);
      }
      .lang-select:hover {
        border-color: var(--axis-yellow);
      }

  body
    .axis-login-topbar
      img.brand-logo(src="/brands/Axis.png" alt="Axis Logo")
      .camera-title #{model}
      .lang-select-container
        select.lang-select(name='language' onchange='changeLanguage(this.value)')
          option(value='en' selected=locale === 'en')= __('language.english')
          option(value='es' selected=locale === 'es')= __('language.spanish')
    .login-card
      h1= __('login.title')
      div#errorMessage.error-message
      form#loginForm
        .input-group
          i.fas.fa-user
          input(type='text' name='username' placeholder=__('login.username') required)
        .input-group
          i.fas.fa-lock
          input(type='password' name='password' placeholder=__('login.password') required)
        button(type='submit')= __('login.loginButton')
        .options
          a(href="/forgot-password")= __('login.forgotPassword')
    script.
      function changeLanguage(lang) {
        window.location.href = '/set-language/' + lang;
      }
      $(document).ready(function() {
        $('#loginForm').submit(function(e) {
          e.preventDefault();
          const username = $('input[name="username"]').val();
          const password = $('input[name="password"]').val();
          const $errorMessage = $('#errorMessage');
          
          
          $errorMessage.text('');
          
          
          const isAdminMode = window.location.pathname === '/admin/login' || #{isAdminMode || false};
          const loginUrl = isAdminMode ? '/admin/login' : '/login';
          
          $.ajax({
            url: loginUrl,
            method: 'POST',
            data: {
              username: username,
              password: password
            },
            success: function(response) {
              console.log('Login success:', response);
              if (response.message === "Login successful" || response.message === "Admin login successful") {
                window.location.href = '/';
              } else {
                $errorMessage.text('Login failed - please try again.');
              }
            },
            error: function(xhr, status, error) {
              console.log('Login error:', xhr.status, xhr.responseText);
              let message = 'An unknown error occurred.';
              if (xhr.status === 404) message = 'User not found.';
              if (xhr.status === 401) message = 'Wrong password.';
              if (xhr.status === 403) message = 'Too many attempts. Try again later.';
              $errorMessage.text(message);
              console.log('Error displayed:', message);
            }
          });
        });
        
        
        $('input[name="username"], input[name="password"]').on('input', function() {
          $('#errorMessage').text('');
        });
      });
