doctype html
html(lang="en")
    head
        meta(charset='UTF-8')
        title #{model}
        link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css")
        style.
            :root {
                --bg-dark: #1a1a1a;
                --bg-medium: #2a2a2a;
                --bg-light: #3a3a3a;
                --text-color: #e0e0e0;
                --accent-color: #00aaff;
            }
            body {
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                background-color: var(--bg-dark);
                margin: 0;
                color: var(--text-color);
                display: flex;
                flex-direction: column;
                height: 100vh;
                overflow-y: hidden;
            }
            .header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 0 20px;
                background-color: var(--bg-dark);
                border-bottom: 1px solid var(--bg-light);
                height: 100px;
                flex-shrink: 0;
            }
            .header-logo img {
                height: 90px;
            }
            .header-nav a {
                color: var(--text-color);
                text-decoration: none;
                margin-left: 20px;
                font-size: 16px;
            }
            .main-container {
                display: flex;
                flex-grow: 1;
                overflow: hidden;
            }
            .sidebar {
                width: 280px;
                background-color: var(--bg-medium);
                padding: 20px;
                border-right: 1px solid var(--bg-light);
                flex-shrink: 0;
            }
            .sidebar h3 {
                font-size: 16px;
                border-bottom: 1px solid var(--bg-light);
                padding-bottom: 10px;
                margin-top: 0;
            }
            .camera-list ul {
                list-style-type: none;
                padding: 0;
            }
            .camera-list li {
                padding: 10px;
                cursor: pointer;
                display: flex;
                align-items: center;
                border-radius: 4px;
                transition: background-color 0.2s;
            }
            .camera-list li:hover {
                background-color: var(--bg-light);
            }
            .camera-list li.active {
                background-color: var(--accent-color);
                color: var(--bg-dark);
            }
            .camera-list i {
                margin-right: 10px;
            }
            .main-content {
                flex-grow: 1;
                display: flex;
                flex-direction: column;
                padding: 20px;
            }
            .video-grid {
                flex-grow: 1;
                display: flex;
                flex-direction: column;
                gap: 20px;
                position: relative;
            }
            .video-main {
                background: black;
                border: 1px solid var(--bg-light);
                display: flex;
                justify-content: center;
                align-items: center;
                flex-grow: 1;
                position: relative;
            }
            #container {
                width: 100%;
                height: 100%;
                display: flex;
                align-items: center;
                justify-content: center;
                background: #000;
                overflow: hidden;
                position: relative;
            }
            #imageViewer {
                position: relative;
                width: 100%;
                height: 100%;
                overflow: hidden;
            }
            #imageViewer img {
                position: absolute;
                top: 0;
                left: 0;
                width: auto;
                height: auto;
                max-width: none;
                max-height: none;
                transform-origin: center;
            }
            .footer-bar {
                height: 60px;
                background-color: var(--bg-medium);
                border-top: 1px solid var(--bg-light);
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 0 20px;
                flex-shrink: 0;
            }
            .footer-bar i {
                font-size: 24px;
                margin: 0 15px;
                cursor: pointer;
                transition: color 0.2s;
            }
            .footer-bar i:hover {
                color: var(--accent-color);
            }
            .footer-bar i.disabled {
                color: #666;
                cursor: not-allowed;
            }
            .image-info {
                position: absolute;
                top: 10px;
                left: 10px;
                background: rgba(0,0,0,0.7);
                color: white;
                padding: 8px 12px;
                border-radius: 4px;
                font-size: 12px;
            }
            .no-images {
                color: white;
                text-align: center;
                font-size: 16px;
            }
            .page-content {
                display: none;
                flex-grow: 1;
                padding: 20px;
                overflow-y: auto;
            }
            .page-content.active {
                display: flex;
                flex-direction: column;
            }
            .camera-info-container {
                background: var(--bg-medium);
                border-radius: 8px;
                box-shadow: 0 2px 8px rgba(0,0,0,0.04);
                padding: 30px;
                max-width: 800px;
                width: 100%;
            }
            .camera-info-container h2 {
                margin-top: 0;
                color: var(--accent-color);
                border-bottom: 2px solid var(--accent-color);
                padding-bottom: 10px;
                font-size: 24px;
            }
            .info-grid {
                display: grid;
                grid-template-columns: repeat(2, 1fr);
                gap: 20px;
                margin-top: 20px;
            }
            .info-item {
                background: var(--bg-dark);
                padding: 20px;
                border-radius: 6px;
                border-left: 4px solid var(--accent-color);
            }
            .info-label {
                font-weight: 600;
                color: var(--text-color);
                margin-bottom: 8px;
                font-size: 14px;
                text-transform: uppercase;
                letter-spacing: 0.5px;
            }
            .info-value {
                color: #b0b0b0;
                font-size: 16px;
            }
            .status-indicator {
                display: inline-block;
                width: 12px;
                height: 12px;
                border-radius: 50%;
                margin-right: 8px;
            }
            .status-online {
                background: #4caf50;
            }
            .status-offline {
                background: #f44336;
            }

            .rtsp-control-item {
                grid-column: span 2;
                margin-top: 10px;
            }
            .rtsp-toggle-container {
                display: flex;
                align-items: center;
                gap: 15px;
            }
            .rtsp-toggle {
                position: relative;
                display: inline-block;
                width: 60px;
                height: 34px;
            }
            .rtsp-toggle-input {
                opacity: 0;
                width: 0;
                height: 0;
            }
            .rtsp-toggle-slider {
                position: absolute;
                cursor: pointer;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background-color: #ccc;
                transition: .4s;
                border-radius: 34px;
            }
            .rtsp-toggle-slider:before {
                position: absolute;
                content: "";
                height: 26px;
                width: 26px;
                left: 4px;
                bottom: 4px;
                background-color: white;
                transition: .4s;
                border-radius: 50%;
            }
            .rtsp-toggle-input:checked + .rtsp-toggle-slider {
                background-color: var(--accent-color);
            }
            .rtsp-toggle-input:checked + .rtsp-toggle-slider:before {
                transform: translateX(26px);
            }
            .rtsp-toggle-input:disabled + .rtsp-toggle-slider {
                opacity: 0.6;
                cursor: not-allowed;
            }
            .rtsp-status-text {
                font-weight: 600;
                font-size: 14px;
            }
            .rtsp-status-text.enabled {
                color: #4caf50;
            }
            .rtsp-status-text.disabled {    
                color: #f44336;
            }
            
             
            .onvif-control-item { 
                grid-column: span 2;
                margin-top: 10px;
            } 
            
            .onvif-toggle-container { 
                display: flex; 
                align-items: center; 
                gap: 15px; 
            } 
            
            .onvif-toggle { 
                position: relative; 
                display: inline-block; 
                width: 60px; 
                height: 34px; 
            } 
            
            .onvif-toggle-input { 
                opacity: 0; 
                width: 0; 
                height: 0; 
            } 
            
            .onvif-toggle-slider { 
                position: absolute; 
                cursor: pointer; 
                top: 0; 
                left: 0; 
                right: 0; 
                bottom: 0; 
                background-color: #ccc;
                transition: .4s;
                border-radius: 34px;
            } 
            
            .onvif-toggle-slider:before { 
                position: absolute; 
                content: ""; 
                height: 26px; 
                width: 26px; 
                left: 4px; 
                bottom: 4px; 
                background-color: white;
                transition: .4s;
                border-radius: 50%;
            } 
            
            .onvif-toggle-input:checked + .onvif-toggle-slider { 
                background-color: var(--accent-color);
            } 
            
            .onvif-toggle-input:checked + .onvif-toggle-slider:before { 
                transform: translateX(26px); 
            } 
            
            .onvif-toggle-input:disabled + .onvif-toggle-slider { 
                opacity: 0.6; 
                cursor: not-allowed; 
            } 
            
            .onvif-status-text { 
                font-weight: 600; 
                font-size: 14px;
            } 
            
            .onvif-status-text.enabled { 
                color: #4caf50; 
            } 
            
            .onvif-status-text.disabled { 
                color: #f44336; 
            }

    body
        header.header
            .header-logo
                img(src=brandImagePath, alt=brand)
            nav.header-nav
                span Welcome, #{userName}
                a(href="/logout")
                    i.fas.fa-sign-out-alt

        .main-container
            aside.sidebar
                h3 My Views
                .camera-list
                    ul
                        li.page-btn.active(data-page="camera")
                            i.fas.fa-video
                            span Camera 1
                        li.page-btn(data-page="info")
                            i.fas.fa-info-circle
                            span Camera Information
            main.main-content
                .page-content.active#camera-page
                    .video-grid
                        .video-main
                            .image-info#imageInfo(style="display: none;")
                            div#container
                                div#imageViewer
                                    .no-images#noImages(style="display: none;") No images found
                        .footer-bar
                            i.fas.fa-chevron-up#up
                            i.fas.fa-chevron-down#down
                            i.fas.fa-chevron-left#left
                            i.fas.fa-chevron-right#right
                .page-content#info-page
                    .camera-info-container
                        h2 Camera Information
                        .info-grid#camera-info-grid
                            .info-item
                                .info-label Camera Model
                                .info-value#camera-model 
                            .info-item
                                .info-label Firmware Version
                                .info-value#firmware-version 
                            .info-item
                                .info-label IP Address
                                .info-value#ip-address 
                            .info-item
                                .info-label MAC Address
                                .info-value#mac-address 
                            .info-item
                                .info-label Resolution
                                .info-value#resolution 
                            .info-item
                                .info-label Frame Rate
                                .info-value#frame-rate 
                            .info-item
                                .info-label Compression
                                .info-value#compression 
                            .info-item
                                .info-label Status
                                .info-value#status
                                    span.status-indicator.status-online
                            .info-item
                                .info-label Uptime
                                .info-value#uptime 
                            .info-item
                                .info-label Last Restart
                                .info-value#last-restart
                            .info-item.onvif-control-item#onvif-control-item(style="display: none;")
                                .info-label #{__("main.onvifService")}
                                .info-value
                                    .onvif-toggle-container
                                        label.onvif-toggle
                                            input.onvif-toggle-input(type="checkbox" id="onvif-toggle")
                                            span.onvif-toggle-slider
                                        span.onvif-status-text#onvif-status-text= __('main.onvifDisabled')
                            .info-item.rtsp-control-item#rtsp-control-item(style="display: none;")
                                .info-label RTSP Service
                                .info-value
                                    .rtsp-toggle-container
                                        label.rtsp-toggle
                                            input.rtsp-toggle-input(type="checkbox" id="rtsp-toggle")
                                            span.rtsp-toggle-slider
                                        span.rtsp-status-text#rtsp-status-text RTSP Disabled

        script.
            
            document.querySelectorAll('.page-btn').forEach(button => {
                button.addEventListener('click', () => {
                    
                    document.querySelectorAll('.page-btn').forEach(btn => btn.classList.remove('active'));
                    document.querySelectorAll('.page-content').forEach(page => page.classList.remove('active'));
                    
                    
                    button.classList.add('active');
                    
                    
                    const pageName = button.getAttribute('data-page');
                    document.getElementById(pageName + '-page').classList.add('active');
                    
                    
                    if (pageName === 'info') {
                        loadCameraInfo();
                    }
                });
            });

            
            function loadCameraInfo() {
                const xhr = new XMLHttpRequest();
                xhr.open('GET', '/api/camera-info', true);
                xhr.withCredentials = true;
                
                xhr.onreadystatechange = function() {
                    if (xhr.readyState === 4) {
                        if (xhr.status === 200) {
                            try {
                                const cameraData = JSON.parse(xhr.responseText);
                                populateCameraInfo(cameraData);
                            } catch (error) {
                                console.error('Error parsing camera info:', error);
                            }
                        } else {
                            console.error('Failed to load camera info:', xhr.status);
                        }
                    }
                };
                
                xhr.send();
            }

            
            function populateCameraInfo(data) {
                
                const fieldMappings = {
                    'camera-model': data.model || 'N/A',
                    'firmware-version': data.firmwareVersion || 'N/A',
                    'ip-address': data.ipAddress || 'N/A',
                    'mac-address': data.macAddress || 'N/A',
                    'resolution': data.resolution || 'N/A',
                    'frame-rate': data.specifications?.fps || 'N/A',
                    'compression': data.specifications?.compression || 'N/A',
                    'status': data.status || 'Online',
                    'uptime': data.uptime || 'Live',
                    'last-restart': data.lastRestart || 'N/A'
                };

                
                Object.keys(fieldMappings).forEach(fieldId => {
                    const element = document.getElementById(fieldId);
                    if (element) {
                        if (fieldId === 'status') {
                            const statusIndicator = element.querySelector('.status-indicator');
                            if (fieldMappings[fieldId] === 'Online') {
                                statusIndicator.className = 'status-indicator status-online';
                            } else {
                                statusIndicator.className = 'status-indicator status-offline';
                            }
                            element.innerHTML = statusIndicator.outerHTML + fieldMappings[fieldId];
                        } else {
                            element.textContent = fieldMappings[fieldId];
                        }
                    }
                });
            }

            let currentImage = null;
            let currentX = 0;
            let currentY = 0;
            let imageWidth = 0;
            let imageHeight = 0;
            let containerWidth = 0;
            let containerHeight = 0;
            const moveStep = 50; 
            
            
            function loadImage() {
                
                const xhr = new XMLHttpRequest();
                xhr.open('GET', '/api/images', true);
                xhr.withCredentials = true;
                
                xhr.onreadystatechange = function() {
                    if (xhr.readyState === 4) {
                        
                        if (xhr.status === 200) {
                            try {
                                const images = JSON.parse(xhr.responseText);
                                if (images.length > 0) {
                                    displayImage(images[0]);
                                } else {
                                    document.getElementById('noImages').style.display = 'block';
                                }
                            } catch (error) {
                                console.error('Error parsing response:', error);
                                document.getElementById('noImages').style.display = 'block';
                            }
                        } else {
                            console.error('API request failed:', xhr.status);
                            document.getElementById('noImages').style.display = 'block';
                        }
                    }
                };
                
                xhr.onerror = function() {
                    console.error('XHR error occurred');
                    document.getElementById('noImages').style.display = 'block';
                };
                
                xhr.send();
            }
            
            
            function displayImage(imageSrc) {
                const imageViewer = document.getElementById('imageViewer');
                const imageInfo = document.getElementById('imageInfo');
                
                
                imageViewer.innerHTML = '';
                
                
                const img = document.createElement('img');
                img.src = imageSrc;
                img.alt = '360 VIEW';
                
                img.onload = function() {
                    
                    imageWidth = this.naturalWidth;
                    imageHeight = this.naturalHeight;
                    
                    
                    containerWidth = imageViewer.clientWidth;
                    containerHeight = imageViewer.clientHeight;
                    
                    
                    currentX = Math.max(0, (imageWidth - containerWidth) / 2);
                    currentY = Math.max(0, (imageHeight - containerHeight) / 2);
                    
                    
                    updateImagePosition();
                    
                    
                    imageInfo.textContent = `Image: ${imageSrc.split('/').pop()}`;
                    imageInfo.style.display = 'block';
                };
                
                img.onerror = function() {
                    console.error('Image failed to load:', imageSrc);
                    document.getElementById('noImages').style.display = 'block';
                };
                
                imageViewer.appendChild(img);
                currentImage = img;
            }
            
            
            function updateImagePosition() {
                if (!currentImage) return;
                
                
                const maxX = Math.max(0, imageWidth - containerWidth);
                const maxY = Math.max(0, imageHeight - containerHeight);
                
                currentX = Math.max(0, Math.min(currentX, maxX));
                currentY = Math.max(0, Math.min(currentY, maxY));
                
                
                currentImage.style.transform = `translate(-${currentX}px, -${currentY}px)`;
            }
            
            
            document.getElementById('up').addEventListener('click', () => {
                currentY -= moveStep;
                updateImagePosition();
            });
            
            document.getElementById('down').addEventListener('click', () => {
                currentY += moveStep;
                updateImagePosition();
            });
            
            document.getElementById('left').addEventListener('click', () => {
                currentX -= moveStep;
                updateImagePosition();
            });
            
            document.getElementById('right').addEventListener('click', () => {
                currentX += moveStep;
                updateImagePosition();
            });
            
            
            
            document.addEventListener('DOMContentLoaded', loadImage);

            async function loadRTSPStatus() {
                try {
                    const response = await fetch('/admin/rtsp/service/8558');
                    if (response.ok) {
                        const data = await response.json();
                        updateRTSPToggle(data.running);
                    } else {
                        console.error('Failed to load RTSP status');
                        updateRTSPToggle(false);
                    }
                } catch (error) {
                    console.error('Error loading RTSP status:', error);
                    updateRTSPToggle(false);
                }
            }

            function updateRTSPToggle(isEnabled) {
                const toggle = document.getElementById('rtsp-toggle');
                const statusText = document.getElementById('rtsp-status-text');
                
                if (toggle && statusText) {
                    toggle.checked = isEnabled;
                    statusText.textContent = isEnabled ? 'RTSP Enabled' : 'RTSP Disabled';
                    statusText.className = `rtsp-status-text ${isEnabled ? 'enabled' : 'disabled'}`;
                }
            }

            async function toggleRTSPService() {
                const toggle = document.getElementById('rtsp-toggle');
                const statusText = document.getElementById('rtsp-status-text');
                
                if (!toggle || !statusText) return;
                
                
                const currentState = toggle.checked;
                const newState = !currentState;
                
                
                toggle.checked = newState;
                statusText.textContent = newState ? 'RTSP Enabled' : 'RTSP Disabled';
                statusText.className = `rtsp-status-text ${newState ? 'enabled' : 'disabled'}`;
                
                
                toggle.disabled = true;
                
                try {
                    const response = await fetch('/admin/rtsp/toggle/rtsp_mobotix', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        }
                    });
                    
                    if (response.ok) {
                        const result = await response.json();
                        if (result.success) {
                            
                            showNotification('RTSP service toggled successfully', 'success');
                            
                            await loadRTSPStatus();
                        } else {
                            
                            showNotification(result.message || 'Failed to toggle RTSP service', 'error');
                            
                            await loadRTSPStatus();
                        }
                    } else if (response.status === 401) {
                        
                        showNotification('Authentication required. Please log in again.', 'error');
                        await loadRTSPStatus();
                        setTimeout(() => {
                            window.location.href = '/login';
                        }, 1500);
                    } else if (response.status === 403) {
                        
                        showNotification('Admin access required. Please log in as admin.', 'error');
                        await loadRTSPStatus();
                        setTimeout(() => {
                            window.location.href = '/login';
                        }, 1500);
                    } else {
                        
                        showNotification('Failed to toggle RTSP service', 'error');
                        await loadRTSPStatus();
                    }
                } catch (error) {
                    console.error('Error toggling RTSP service:', error);
                    showNotification('Failed to toggle RTSP service', 'error');
                    
                    await loadRTSPStatus();
                } finally {
                    
                    toggle.disabled = false;
                }
            }

            
            async function loadONVIFStatus() { 
                try { 
                    const response = await fetch("/admin/onvif/service/8089"); 
                    if (response.ok) { 
                        const data = await response.json(); 
                        updateONVIFToggle(data.running); 
                    } else { 
                        console.error("Failed to load ONVIF status"); 
                        updateONVIFToggle(false); 
                    } 
                } catch (error) { 
                    console.error("Error loading ONVIF status:", error); 
                    updateONVIFToggle(false); 
                } 
            } 
            
            function updateONVIFToggle(isEnabled) { 
                const toggle = document.getElementById("onvif-toggle"); 
                const statusText = document.getElementById("onvif-status-text"); 
                
                if (toggle && statusText) { 
                    toggle.checked = isEnabled; 
                    statusText.textContent = isEnabled ? "!{__("main.onvifEnabled")}" : "!{__("main.onvifDisabled")}"; 
                    statusText.className = `onvif-status-text ${isEnabled ? "enabled" : "disabled"}`; 
                } 
            } 
            
            async function toggleONVIFService() { 
                const toggle = document.getElementById("onvif-toggle"); 
                const statusText = document.getElementById("onvif-status-text"); 
                
                if (!toggle || !statusText) return; 
                
                
                const currentState = toggle.checked;
                const newState = !currentState;
                
                
                toggle.checked = newState;
                statusText.textContent = newState ? "!{__("main.onvifEnabled")}" : "!{__("main.onvifDisabled")}";
                statusText.className = `onvif-status-text ${newState ? "enabled" : "disabled"}`;
                
                
                toggle.disabled = true; 
                
                try { 
                    const response = await fetch("/admin/onvif/toggle/onvif_mobotix_service", { 
                        method: "POST", 
                        headers: { 
                            "Content-Type": "application/json" 
                        } 
                    }); 
                    
                    if (response.ok) { 
                        const result = await response.json(); 
                        if (result.success) { 
                            
                            showNotification("!{__("main.onvifToggleSuccess")}", "success");
                            
                            await loadONVIFStatus();
                        } else { 
                            
                            showNotification(result.message || "!{__("main.onvifToggleError")}", "error");
                            
                            await loadONVIFStatus();
                        } 
                    } else if (response.status === 401) {
                        
                        showNotification('Authentication required. Please log in again.', 'error');
                        await loadONVIFStatus();
                        setTimeout(() => {
                            window.location.href = '/login';
                        }, 1500);
                    } else if (response.status === 403) {
                        
                        showNotification('Admin access required. Please log in as admin.', 'error');
                        await loadONVIFStatus();
                        setTimeout(() => {
                            window.location.href = '/login';
                        }, 1500);
                    } else { 
                        
                        showNotification("!{__("main.onvifToggleError")}", "error");
                        await loadONVIFStatus();
                    } 
                } catch (error) { 
                    console.error("Error toggling ONVIF service:", error); 
                    showNotification("!{__("main.onvifToggleError")}", "error");
                    
                    await loadONVIFStatus();
                } finally { 
                    
                    toggle.disabled = false; 
                } 
            } 
            
            
            async function checkONVIFAdminStatus() { 
                try { 
                    const response = await fetch("/admin/onvif/status"); 
                    if (response.ok) { 
                        const onvifControlItem = document.getElementById("onvif-control-item"); 
                        if (onvifControlItem) { 
                            onvifControlItem.style.display = "block"; 
                        } 
                        loadONVIFStatus(); 
                    } else if (response.status === 403) { 
                        const onvifControlItem = document.getElementById("onvif-control-item"); 
                        if (onvifControlItem) { 
                            onvifControlItem.style.display = "none"; 
                        } 
                    } 
                } catch (error) { 
                    console.error("Error checking ONVIF admin status:", error); 
                    const onvifControlItem = document.getElementById("onvif-control-item"); 
                    if (onvifControlItem) { 
                        onvifControlItem.style.display = "none"; 
                    } 
                } 
            }

            function showNotification(message, type) {
                
                const notification = document.createElement('div');
                notification.style.cssText = `
                    position: fixed;
                    top: 20px;
                    right: 20px;
                    padding: 15px 20px;
                    border-radius: 5px;
                    color: white;
                    font-weight: bold;
                    z-index: 1000;
                    background-color: ${type === 'success' ? '#4caf50' : '#f44336'};
                `;
                notification.textContent = message;
                
                document.body.appendChild(notification);
                
                setTimeout(() => {
                    if (notification.parentNode) {
                        notification.parentNode.removeChild(notification);
                    }
                }, 3000);
            }

            async function checkAdminStatus() {
                try {
                    const response = await fetch('/admin/rtsp/status');
                    if (response.ok) {
                        const rtspControlItem = document.getElementById('rtsp-control-item');
                        if (rtspControlItem) {
                            rtspControlItem.style.display = 'block';
                        }
                        loadRTSPStatus();
                    } else {
                        const rtspControlItem = document.getElementById('rtsp-control-item');
                        if (rtspControlItem) {
                            rtspControlItem.style.display = 'none';
                        }
                    }
                } catch (error) {
                    console.error('Error checking admin status:', error);
                    const rtspControlItem = document.getElementById('rtsp-control-item');
                    if (rtspControlItem) {
                        rtspControlItem.style.display = 'none';
                    }
                }
            }

            document.addEventListener('DOMContentLoaded', function() {
                checkAdminStatus();
                checkONVIFAdminStatus();
                
                const rtspToggle = document.getElementById('rtsp-toggle');
                if (rtspToggle) {
                    rtspToggle.addEventListener('change', toggleRTSPService);
                const onvifToggle = document.getElementById("onvif-toggle"); 
                if (onvifToggle) { 
                    onvifToggle.addEventListener("change", toggleONVIFService); 
                }
                }
                
                const lastActiveTab = localStorage.getItem('lastActiveTab');
                if (lastActiveTab) {
                    localStorage.removeItem('lastActiveTab');
                    const tabButton = document.querySelector(`[data-page="${lastActiveTab}"]`);
                    if (tabButton) {
                        tabButton.click();
                    }
                }
            });
