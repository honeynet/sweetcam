doctype html
html
    head
        meta(charset='UTF-8')
        title= __('login.resetPassword')
        script(src='https://code.jquery.com/jquery-3.6.0.min.js')
        script(src='https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js')
        style.
            body {
                background: linear-gradient(to bottom, #eee 0%, #222 100%);
                font-family: Arial, sans-serif;
                margin: 0;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                height: 100vh;
            }
            .reset-container {
                background: #fff;
                padding: 30px;
                border-radius: 4px;
                width: 360px;
                border: 1px solid #aaa;
                box-shadow: 0 4px 8px rgba(0,0,0,0.2);
            }
            .brand-logo {
                width: 150px;
                margin-bottom: 20px;
            }
            h2 {
                font-size: 1.2em;
                color: #222;
                margin-bottom: 15px;
            }
            p {
                font-size: 13px;
                color: #444;
                margin-bottom: 20px;
                line-height: 1.4;
            }
            .form-group {
                margin-bottom: 15px;
            }
            .form-group label {
                display: block;
                font-size: 13px;
                margin-bottom: 5px;
                color: #222;
            }
            .form-group input {
                width: 100%;
                padding: 8px;
                border: 1px solid #aaa;
                border-radius: 4px;
                box-sizing: border-box;
            }
            button {
                background: #eaeaea;
                border: 1px solid #888;
                padding: 10px;
                border-radius: 2px;
                cursor: pointer;
                width: 100%;
                font-size: 14px;
                transition: background 0.2s;
            }
            button:hover {
                background: #d6d6d6;
            }
            .message {
                margin-top: 15px;
                font-size: 13px;
                text-align: center;
                display: none;
            }
            .success { color: green; }
            .error { color: red; }
            .back-link {
                display: block;
                margin-top: 20px;
                text-align: center;
                font-size: 13px;
                color: #444;
                text-decoration: none;
            }
    body
        .reset-container
            img.brand-logo(src="/brands/login-vstarcam.png" alt="Vstarcam Logo")
            h2= __('login.resetPassword')
            p To reset your device password, please use the Eye4 mobile app and scan the QR code on the bottom of the device, or enter the recovery key.
            form#resetForm
                .form-group
                    label(for="username")= __('login.username')
                    input(type="text" id="username" name="username" required)
                .form-group
                    label(for="key") Recovery Key
                    input(type="text" id="key" name="key" placeholder="Enter recovery key" required)
                button(type="submit") Process Reset
            #message.message
            a.back-link(href="/login") Back to Login
        script.
            $(document).ready(function() {
                $('#resetForm').submit(function(e) {
                    e.preventDefault();
                    const payload = {
                        username: $('#username').val(),
                        key: $('#key').val(),
                        brand: 'vstarcam'
                    };
                    const $message = $('#message');
                    
                    $('button').prop('disabled', true).text('Processing...');
                    
                    axios.post('/forgot-password', payload)
                    .then(response => {
                        $message.text('Verification complete. Please use the mobile app to set your new password.').removeClass('error').addClass('success').show();
                    })
                    .catch(error => {
                        $message.text('Recovery key validation failed. Please try again.').removeClass('success').addClass('error').show();
                    })
                    .finally(() => {
                        $('button').prop('disabled', false).text('Process Reset');
                    });
                });
            });
