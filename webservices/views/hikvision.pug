doctype html
html
    head
        meta(charset='UTF-8')
        title #{model}
        style.
            body {
                margin: 0;
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                background: #f5f6fa;
            }
            .topbar {
                background: #23262b;
                color: white;
                padding: 18px 32px;
                display: flex;
                justify-content: flex-end;
                align-items: center;
            }
            .sidebar-logo {
                display: flex;
                justify-content: center;
                padding: 20px 0;
                border-bottom: 1px solid #3a3f45;
            }
            .sidebar-logo img {
                height: 40px;
            }
            .user-section {
                display: flex;
                align-items: center;
                gap: 20px;
            }
            .sidebar {
                width: 220px;
                background: #23262b;
                color: white;
                height: 100vh;
                position: fixed;
                top: 0;
                left: 0;
            }
            .sidebar ul {
                list-style: none;
                padding: 0;
                margin: 0;
            }
            .sidebar li {
                padding: 18px 32px;
                cursor: pointer;
                font-size: 1.1em;
            }
            .sidebar li.active, .sidebar li:hover {
                background: #e53935;
                color: white;
            }
            .main-content {
                margin-left: 220px;
                padding: 48px 32px;
                display: flex;
                gap: 30px;
            }
            .video-container {
                flex-grow: 1;
                background: black;
                border-radius: 8px;
                overflow: hidden;
                display: flex;
                flex-direction: column;
                align-items: center;
                position: relative;
                min-height: 450px;
            }
            #container {
                width: 100%;
                height: 100%;
                flex-grow: 1;
                display: flex;
                align-items: center;
                justify-content: center;
                background: #000;
                overflow: hidden;
                position: relative;
            }
            #imageViewer {
                position: relative;
                width: 100%;
                height: 100%;
                overflow: hidden;
            }
            #imageViewer img {
                position: absolute;
                top: 0;
                left: 0;
                width: auto;
                height: auto;
                max-width: none;
                max-height: none;
                transform-origin: center;
            }
            #control {
                padding: 10px;
                background: #23262b;
                width: 100%;
                text-align: center;
                position: absolute;
                bottom: 0;
                box-sizing: border-box;
            }
            #control button {
                background: #e53935;
                color: white;
                border: none;
                padding: 8px 16px;
                border-radius: 4px;
                cursor: pointer;
                margin: 0 5px;
                font-size: 16px;
            }
            #control button:disabled {
                background: #666;
                cursor: not-allowed;
            }
            .settings-box {
                background: white;
                border-radius: 8px;
                box-shadow: 0 2px 8px rgba(0,0,0,0.04);
                padding: 32px;
                max-width: 480px;
            }
            .settings-box h2 {
                margin-top: 0;
                color: #e53935;
            }
            .settings-box label {
                display: block;
                margin: 18px 0 6px 0;
                color: #23262b;
            }
            .settings-box input, .settings-box select {
                width: 100%;
                padding: 10px;
                border: 1px solid #ccc;
                border-radius: 4px;
                margin-bottom: 12px;
            }
            .settings-box button {
                background: #e53935;
                color: white;
                border: none;
                padding: 12px 32px;
                border-radius: 4px;
                font-size: 1em;
                cursor: pointer;
            }
            .user-info {
                color: white;
                font-size: 16px;
            }
            .logout-btn {
                background-color: #EC412D;
                color: white;
                padding: 8px 16px;
                border: none;
                border-radius: 4px;
                cursor: pointer;
                text-decoration: none;
                font-size: 14px;
                transition: background-color 0.3s;
            }
            .logout-btn:hover {
                background-color: #d32f2f;
            }
            .image-info {
                position: absolute;
                top: 10px;
                left: 10px;
                background: rgba(0,0,0,0.7);
                color: white;
                padding: 8px 12px;
                border-radius: 4px;
                font-size: 12px;
            }
            .no-images {
                color: white;
                text-align: center;
                font-size: 16px;
            }
            .content-section {
                display: none;
                flex-grow: 1;
            }
            .content-section.active {
                display: flex;
            }
            .camera-info-container {
                background: white;
                border-radius: 8px;
                box-shadow: 0 2px 8px rgba(0,0,0,0.04);
                padding: 32px;
                max-width: 800px;
                width: 100%;
            }
            .camera-info-container h2 {
                margin-top: 0;
                color: #e53935;
                border-bottom: 2px solid #e53935;
                padding-bottom: 10px;
            }
            .info-grid {
                display: grid;
                grid-template-columns: repeat(2, 1fr);
                gap: 20px;
                margin-top: 20px;
            }
            .info-item {
                background: #f8f9fa;
                padding: 20px;
                border-radius: 6px;
                border-left: 4px solid #e53935;
            }
            .info-label {
                font-weight: 600;
                color: #23262b;
                margin-bottom: 8px;
                font-size: 14px;
                text-transform: uppercase;
                letter-spacing: 0.5px;
            }
            .info-value {
                color: #555;
                font-size: 16px;
            }
            .status-indicator {
                display: inline-block;
                width: 12px;
                height: 12px;
                border-radius: 50%;
                margin-right: 8px;
            }
            .status-online {
                background: #4caf50;
            }
            .status-offline {
                background: #f44336;
            }
    body
        .topbar
            .user-section
                span.user-info Welcome, #{userName}!
                a.logout-btn(href="/logout") Logout
        .sidebar
            .sidebar-logo
                img(src=brandImagePath, alt=brand)
            ul
                li.tab-btn.active(data-tab="camera") Camera 1
                li.tab-btn(data-tab="info") Camera Information
        .main-content
            .content-section.active#camera-section
                .video-container
                    .image-info#imageInfo(style="display: none;")
                    div(id='container')
                        div(id='imageViewer')
                            .no-images#noImages(style="display: none;") No images found
                    div(id='control')
                        button(id='up' type='button') &#x25B2;
                        button(id='down' type='button') &#x25BC;
                        button(id='left' type='button') &#x25C0;
                        button(id='right' type='button') &#x25B6;
            .content-section#info-section
                .camera-info-container
                    h2 Camera Information
                    .info-grid#camera-info-grid
                        .info-item
                            .info-label Camera Model
                            .info-value#camera-model
                        .info-item
                            .info-label Firmware Version
                            .info-value#firmware-version
                        .info-item
                            .info-label IP Address
                            .info-value#ip-address
                        .info-item
                            .info-label MAC Address
                            .info-value#mac-address
                        .info-item
                            .info-label Resolution
                            .info-value#resolution
                        .info-item
                            .info-label Frame Rate
                            .info-value#frame-rate
                        .info-item
                            .info-label Compression
                            .info-value#compression
                        .info-item
                            .info-label Status
                            .info-value#status
                                span.status-indicator.status-online
                        .info-item
                            .info-label Uptime
                            .info-value#uptime
                        .info-item
                            .info-label Last Restart
                            .info-value#last-restart
        script.
            //tab switching functionality
            document.querySelectorAll('.tab-btn').forEach(button => {
                button.addEventListener('click', () => {
                    //remove active class from all tabs and sections
                    document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
                    document.querySelectorAll('.content-section').forEach(section => section.classList.remove('active'));
                    
                    //add active class to clicked tab
                    button.classList.add('active');
                    
                    //show corresponding section
                    const tabName = button.getAttribute('data-tab');
                    document.getElementById(tabName + '-section').classList.add('active');
                    
                    //load camera info when info tab is clicked
                    if (tabName === 'info') {
                        loadCameraInfo();
                    }
                });
            });

            //function to load camera information from API
            function loadCameraInfo() {
                const xhr = new XMLHttpRequest();
                xhr.open('GET', '/api/camera-info', true);
                xhr.withCredentials = true;
                
                xhr.onreadystatechange = function() {
                    if (xhr.readyState === 4) {
                        if (xhr.status === 200) {
                            try {
                                const cameraData = JSON.parse(xhr.responseText);
                                populateCameraInfo(cameraData);
                            } catch (error) {
                                console.error('Error parsing camera info:', error);
                            }
                        } else {
                            console.error('Failed to load camera info:', xhr.status);
                        }
                    }
                };
                
                xhr.send();
            }

            //function to populate camera information
            function populateCameraInfo(data) {
                //map JSON data to display fields
                const fieldMappings = {
                    'camera-model': data.model || 'N/A',
                    'firmware-version': data.firmwareVersion || 'N/A',
                    'ip-address': data.ipAddress || 'N/A',
                    'mac-address': data.macAddress || 'N/A',
                    'resolution': data.resolution || 'N/A',
                    'frame-rate': data.specifications?.fps || 'N/A',
                    'compression': data.specifications?.compression || 'N/A',
                    'status': data.status || 'Online',
                    'uptime': data.uptime || 'Live',
                    'last-restart': data.lastRestart || 'N/A'
                };

                //update each field
                Object.keys(fieldMappings).forEach(fieldId => {
                    const element = document.getElementById(fieldId);
                    if (element) {
                        if (fieldId === 'status') {
                            const statusIndicator = element.querySelector('.status-indicator');
                            if (fieldMappings[fieldId] === 'Online') {
                                statusIndicator.className = 'status-indicator status-online';
                            } else {
                                statusIndicator.className = 'status-indicator status-offline';
                            }
                            element.innerHTML = statusIndicator.outerHTML + fieldMappings[fieldId];
                        } else {
                            element.textContent = fieldMappings[fieldId];
                        }
                    }
                });
            }

            let currentImage = null;
            let currentX = 0;
            let currentY = 0;
            let imageWidth = 0;
            let imageHeight = 0;
            let containerWidth = 0;
            let containerHeight = 0;
            const moveStep = 50; // pixels to move per arrow press
            
            //function to load the first image from the server
            function loadImage() {
                const xhr = new XMLHttpRequest();
                xhr.open('GET', '/api/images', true);
                xhr.withCredentials = true;
                
                xhr.onreadystatechange = function() {
                    if (xhr.readyState === 4) {
                       
                        if (xhr.status === 200) {
                            try {
                                const images = JSON.parse(xhr.responseText);
                                if (images.length > 0) {
                                    displayImage(images[0]);
                                } else {
                                    console.log('No images found');
                                    document.getElementById('noImages').style.display = 'block';
                                }
                            } catch (error) {
                                console.error('Error parsing response:', error);
                                document.getElementById('noImages').style.display = 'block';
                            }
                        } else {
                            console.error('API request failed:', xhr.status);
                            document.getElementById('noImages').style.display = 'block';
                        }
                    }
                };
                
                xhr.onerror = function() {
                    console.error('XHR error occurred');
                    document.getElementById('noImages').style.display = 'block';
                };
                
                xhr.send();
            }
            
            //function to display image
            function displayImage(imageSrc) {
                const imageViewer = document.getElementById('imageViewer');
                const imageInfo = document.getElementById('imageInfo');
                                
                //clear previous content
                imageViewer.innerHTML = '';
                
                //create and display image
                const img = document.createElement('img');
                img.src = imageSrc;
                img.alt = '360 VIEW';
                
                console.log('Created img element:', img);
                
                img.onload = function() {
                    console.log('Image loaded successfully');
                    //get image dimensions
                    imageWidth = this.naturalWidth;
                    imageHeight = this.naturalHeight;
                    
                    //get container dimensions
                    containerWidth = imageViewer.clientWidth;
                    containerHeight = imageViewer.clientHeight;
                    
                    //set initial position (center of image, but ensure it's visible)
                    currentX = Math.max(0, (imageWidth - containerWidth) / 2);
                    currentY = Math.max(0, (imageHeight - containerHeight) / 2);                    
                    //apply initial transform
                    updateImagePosition();
                    
                    //show image info
                    imageInfo.textContent = `Image: ${imageSrc.split('/').pop()}`;
                    imageInfo.style.display = 'block';
                };
                
                img.onerror = function() {
                    console.error('Image failed to load:', imageSrc);
                    document.getElementById('noImages').style.display = 'block';
                };
                
                imageViewer.appendChild(img);
                currentImage = img;
            }
            
            //function to update image position
            function updateImagePosition() {
                if (!currentImage) return;
                
                //constrain position within image bounds
                const maxX = Math.max(0, imageWidth - containerWidth);
                const maxY = Math.max(0, imageHeight - containerHeight);
                
                currentX = Math.max(0, Math.min(currentX, maxX));
                currentY = Math.max(0, Math.min(currentY, maxY));
                                
                //apply transform
                currentImage.style.transform = `translate(-${currentX}px, -${currentY}px)`;
            }
            
            //event listeners for navigation
            document.getElementById('up').addEventListener('click', () => {
                currentY -= moveStep;
                updateImagePosition();
            });
            
            document.getElementById('down').addEventListener('click', () => {
                currentY += moveStep;
                updateImagePosition();
            });
            
            document.getElementById('left').addEventListener('click', () => {
                currentX -= moveStep;
                updateImagePosition();
            });
            
            document.getElementById('right').addEventListener('click', () => {
                currentX += moveStep;
                updateImagePosition();
            });
            
            //load image when page loads
            document.addEventListener('DOMContentLoaded', loadImage);
