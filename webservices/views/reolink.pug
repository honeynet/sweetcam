doctype html
html(lang="en")
  head
    meta(charset='UTF-8')
    title Reolink Camera
            link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css")
    style.
      body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background: #181d23;
        margin: 0;
        color: #fff;
        min-height: 100vh;
      }
      .reolink-header {
        display: flex;
        align-items: center;
        justify-content: center;
        background: #232a34;
        padding: 0 32px;
        height: 56px;
        border-bottom: 2px solid #1e90ff;
        position: relative;
      }
      .reolink-header .logo {
        display: flex;
        align-items: center;
        gap: 12px;
        position: absolute;
        left: 32px;
        top: 0;
        height: 56px;
      }
      .reolink-header img {
        height: 32px;
        align-self: center;
      }
      .reolink-header .tabs {
        display: flex;
        gap: 32px;
        justify-content: center;
        align-items: center;
        width: 100%;
      }
      .reolink-header .tab {
        color: #b0b8c1;
        font-size: 1.1em;
        font-weight: 500;
        cursor: pointer;
        padding-bottom: 4px;
        border-bottom: 2px solid transparent;
        transition: color 0.2s, border-bottom 0.2s;
      }
      .reolink-header .tab.active {
        color: #1e90ff;
        border-bottom: 2px solid #1e90ff;
      }
      .main-layout {
        display: flex;
        height: calc(100vh - 56px);
        align-items: stretch;
        justify-content: flex-start;
        overflow: hidden;
      }
      
      @media (max-width: 1200px) {
        .info-tab-content {
          max-width: 95%;
          padding: 20px;
        }
        
        .video-player {
          max-width: 95%;
        }
        
        #container {
          max-width: 95%;
        }
      }
      
      @media (max-width: 768px) {
        .left-bar {
          width: 150px;
        }
        
        .info-tab-content {
          padding: 15px;
        }
        
        .video-area {
          padding: 10px;
        }
      }
      .video-area {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: stretch;
        background: #181d23;
        position: relative;
        min-width: 0;
        height: 100%;
        padding: 20px;
        box-sizing: border-box;
        overflow: hidden;
      }
      .video-player {
        background: #000;
        border: 2px solid #222831;
        width: 100%;
        max-width: 900px;
        min-height: 400px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        position: relative;
        margin-bottom: 0;
        box-shadow: 0 4px 24px 0 rgba(30,144,255,0.10);
      }
      #container {
        flex: 1 1 0;
        width: 100%;
        max-width: 900px;
        min-height: 360px;
        height: 450px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #000;
        overflow: hidden;
        position: relative;
        margin: 0 auto;
        border-radius: 10px;
        box-sizing: border-box;
      }
      #imageViewer {
        width: 100%;
        height: 100%;
        position: relative;
        overflow: hidden;
        border-radius: 10px;
      }
      #imageViewer img {
        position: absolute;
        top: 0;
        left: 0;
        width: auto;
        height: auto;
        max-width: none;
        max-height: none;
        user-select: none;
        transform-origin: top left;
      }
      #control {
        display: flex;
        justify-content: center;
        gap: 10px;
        margin-top: 18px;
        width: 100%;
        background: transparent;
      }
      .arrow-btn {
        background: #1e90ff;
        color: #fff;
        border: none;
        border-radius: 50%;
        width: 32px;
        height: 32px;
        font-size: 1em;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 2px 8px rgba(30,144,255,0.10);
        cursor: pointer;
        transition: background 0.2s, color 0.2s, transform 0.1s;
      }
      .arrow-btn:active, .arrow-btn:focus {
        outline: none;
        background: #1877cc;
      }
      .arrow-btn:hover {
        background: #1877cc;
        color: #fff;
        transform: translateY(-2px) scale(1.08);
      }
      .user-actions {
        display: flex;
        align-items: center;
        gap: 18px;
        position: absolute;
        right: 32px;
        top: 12px;
      }
      .user-icon {
        font-size: 2em;
        color: #1e90ff;
        margin-right: 6px;
      }
      .settings-icon {
        font-size: 1.6em;
        color: #1e90ff;
        margin-left: 10px;
        cursor: pointer;
      }
      .leave-icon {
        font-size: 1.6em;
        color: #1e90ff;
        margin-left: 10px;
        cursor: pointer;
      }
      .left-bar {
        width: 200px;
        background: #232a34;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
        height: 100%;
        padding-top: 32px;
        border-right: 1px solid #222831;
      }
      .room-tab {
        background: #181d23;
        color: #fff;
        padding: 18px 12px;
        margin-bottom: 18px;
        width: 170px;
        text-align: center;
        font-weight: 500;
        font-size: 1.1em;
        box-shadow: 0 2px 8px rgba(30,144,255,0.05);
        border: 1px solid #1e90ff;
        cursor: pointer;
        transition: background 0.2s, color 0.2s;
      }
      .room-tab:hover {
        background: #1e90ff;
        color: #fff;
      }
      .info-tab-content {
        border: 2px solid #222831;
        border-radius: 10px;
        background: #232a34;
        color: #fff;
        padding: 32px;
        width: 100%;
        max-width: 900px;
        min-height: 400px;
        margin: 0 auto; 
        box-shadow: 0 4px 24px rgba(30,144,255,0.10); /* match .video-player */
        text-align: left;
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        margin-top: 20px;
        box-sizing: border-box;
        overflow-y: auto;
      }
      .rtsp-control-item {
        margin-top: 20px;
        padding: 20px;
        background: #181d23;
        border-radius: 8px;
        border-left: 4px solid #1e90ff;
        width: 100%;
        box-sizing: border-box;
      }
      .rtsp-toggle-container {
        display: flex;
        align-items: center;
        gap: 15px;
      }
      .rtsp-toggle {
        position: relative;
        display: inline-block;
        width: 60px;
        height: 34px;
      }
      .rtsp-toggle-input {
        opacity: 0;
        width: 0;
        height: 0;
      }
      .rtsp-toggle-slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: #ccc;
        transition: .4s;
        border-radius: 34px;
      }
      .rtsp-toggle-slider:before {
        position: absolute;
        content: "";
        height: 26px;
        width: 26px;
        left: 4px;
        bottom: 4px;
        background-color: white;
        transition: .4s;
        border-radius: 50%;
      }
      .rtsp-toggle-input:checked + .rtsp-toggle-slider {
        background-color: #1e90ff;
      }
      .rtsp-toggle-input:checked + .rtsp-toggle-slider:before {
        transform: translateX(26px);
      }
      .rtsp-toggle-input:disabled + .rtsp-toggle-slider {
        opacity: 0.6;
        cursor: not-allowed;
      }
      .rtsp-status-text {
        font-weight: 600;
        font-size: 14px;
      }
      .rtsp-status-text.enabled {
        color: #4caf50;
      }
      .rtsp-status-text.disabled {
        color: #f44336;
      }
