  body
    .reolink-header
      .logo
        img(src="/brands/Reolink.png" alt="Reolink Logo")
      .tabs
        span.tab.active#live-tab Live View
        span.tab#info-tab Information
      .user-actions
        i.fas.fa-user-circle.user-icon(title="User")
        a(href="/logout" title="Logout")
          i.fas.fa-sign-out-alt.leave-icon(style="margin-left:10px;font-size:1.6em;")
    .main-layout
      .left-bar
        .room-tab Room 1
      .video-area(style='display:;')
        div#container
          div#imageViewer
            .image-info#imageInfo(style="display: none;")
            .no-images#noImages(style="display: none; color: #b0b8c1; font-size: 1.2em;") No images found
        #control
          button.arrow-btn#up(type='button' title='Up')
            i.fas.fa-arrow-up
          button.arrow-btn#down(type='button' title='Down')
            i.fas.fa-arrow-down
          button.arrow-btn#left(type='button' title='Left')
            i.fas.fa-arrow-left
          button.arrow-btn#right(type='button' title='Right')
            i.fas.fa-arrow-right
      .info-tab-content#info-tab-content(style='display:none;')
        h2#infoTitle(style='color:#1e90ff; margin-top:0;')
        ul#infoList(style='list-style:none; padding:0; font-size:1.1em;')
        div#errorInfo(style='color:#ff4d4d; margin-top:12px; display:none;')
        .rtsp-control-item#rtsp-control-item(style="display: none;")
            h3(style='color:#1e90ff; margin-top:0; margin-bottom:15px;') RTSP Service
            .rtsp-toggle-container
              label.rtsp-toggle
                input.rtsp-toggle-input(type="checkbox" id="rtsp-toggle")
                span.rtsp-toggle-slider
              span.rtsp-status-text#rtsp-status-text RTSP Disabled
        .onvif-control-item#onvif-control-item(style="display: none;")
            h3(style='color:#1e90ff; margin-top:0; margin-bottom:15px;') #{__("main.onvifService")}
            .onvif-toggle-container
              label.onvif-toggle
                input.onvif-toggle-input(type="checkbox" id="onvif-toggle")
                span.onvif-toggle-slider
              span.onvif-status-text#onvif-status-text= __('main.onvifDisabled')
    script.
      let currentImage = null;
      let currentX = 0;
      let currentY = 0;
      let imageWidth = 0;
      let imageHeight = 0;
      let containerWidth = 0;
      let containerHeight = 0;
      const moveStep = 50; 

      
      function loadImage() {
          const xhr = new XMLHttpRequest();
          xhr.open('GET', '/api/images', true);
          xhr.withCredentials = true;
          xhr.onreadystatechange = function() {
              if (xhr.readyState === 4) {
                  if (xhr.status === 200) {
                      try {
                          const images = JSON.parse(xhr.responseText);
                          if (images.length > 0) {
                              displayImage(images[0]);
                          } else {
                              console.log('No images found');
                              document.getElementById('noImages').style.display = 'block';
                          }
                      } catch (error) {
                          console.error('Error parsing response:', error);
                          document.getElementById('noImages').style.display = 'block';
                      }
                  } else {
                      console.error('API request failed:', xhr.status);
                      document.getElementById('noImages').style.display = 'block';
                  }
              }
          };
          xhr.onerror = function() {
              console.error('XHR error occurred');
              document.getElementById('noImages').style.display = 'block';
          };
          xhr.send();
      }

      
      function displayImage(imageSrc) {
          const imageViewer = document.getElementById('imageViewer');
          const imageInfo = document.getElementById('imageInfo');
          
          imageViewer.innerHTML = '';
          
          const img = document.createElement('img');
          img.src = imageSrc;
          img.alt = '360 VIEW';
          img.style.position = 'absolute';
          img.style.top = '0';
          img.style.left = '0';
          img.style.userSelect = 'none';
          img.style.maxWidth = 'none';
          img.style.maxHeight = 'none';
          img.draggable = false;
          console.log('Created img element:', img);
          img.onload = function() {
              console.log('Image loaded successfully');
              
              imageWidth = this.naturalWidth;
              imageHeight = this.naturalHeight;
              
              containerWidth = imageViewer.clientWidth;
              containerHeight = imageViewer.clientHeight;
              
              currentX = Math.max(0, (imageWidth - containerWidth) / 2);
              currentY = Math.max(0, (imageHeight - containerHeight) / 2);
              
              updateImagePosition();
              
              imageInfo.textContent = `Image: ${imageSrc.split('/').pop()}`;
              imageInfo.style.display = 'block';
          };
          img.onerror = function() {
              console.error('Image failed to load:', imageSrc);
              document.getElementById('noImages').style.display = 'block';
          };
          imageViewer.appendChild(img);
          currentImage = img;
      }

      
      function updateImagePosition() {
          if (!currentImage) return;
          
          const maxX = Math.max(0, imageWidth - containerWidth);
          const maxY = Math.max(0, imageHeight - containerHeight);
          currentX = Math.max(0, Math.min(currentX, maxX));
          currentY = Math.max(0, Math.min(currentY, maxY));
          
          currentImage.style.transform = `translate(-${currentX}px, -${currentY}px)`;
      }

      
      document.addEventListener('DOMContentLoaded', function() {
          document.getElementById('up').addEventListener('click', () => {
              currentY -= moveStep;
              updateImagePosition();
          });
          document.getElementById('down').addEventListener('click', () => {
              currentY += moveStep;
              updateImagePosition();
          });
          document.getElementById('left').addEventListener('click', () => {
              currentX -= moveStep;
              updateImagePosition();
          });
          document.getElementById('right').addEventListener('click', () => {
              currentX += moveStep;
              updateImagePosition();
          });
          loadImage();
      });

      
      document.addEventListener('DOMContentLoaded', function() {
        const liveTab = document.getElementById('live-tab');
        const infoTab = document.getElementById('info-tab');
        const infoTabContent = document.getElementById('info-tab-content');
        const videoArea = document.querySelector('.video-area');
        function showTab(tab) {
          if(tab === 'live') {
            liveTab.classList.add('active');
            infoTab.classList.remove('active');
            if(videoArea) videoArea.style.display = '';
            infoTabContent.style.display = 'none';
          } else {
            liveTab.classList.remove('active');
            infoTab.classList.add('active');
            if(videoArea) videoArea.style.display = 'none';
            infoTabContent.style.display = '';
            loadReolinkInfo();
          }
        }
        liveTab.addEventListener('click', function() { showTab('live'); });
        infoTab.addEventListener('click', function() { showTab('info'); });
        
        showTab('live');
      });

      
      async function loadReolinkInfo() {
        const infoTitle = document.getElementById('infoTitle');
        const infoList = document.getElementById('infoList');
        const errorInfo = document.getElementById('errorInfo');
        infoTitle.textContent = '';
        infoList.innerHTML = '';
        errorInfo.style.display = 'none';
        try {
          const res = await fetch('/config/reolink.json');
          if (!res.ok) throw new Error('Failed to load');
          const data = await res.json();
          infoTitle.textContent = `${data.brand || ''} ${data.model || ''} - Information`;
          let html = '';
          if (data.model) html += `<li><b>Model:</b> ${data.model}</li>`;
          if (data.type) html += `<li><b>Type:</b> ${data.type}</li>`;
          if (data.resolution) html += `<li><b>Resolution:</b> ${data.resolution}</li>`;
          if (data.features) {
            html += `<li><b>Features:</b><ul style='margin:0 0 0 18px;'>`;
            Object.entries(data.features).forEach(([k,v]) => {
              html += `<li>${k.charAt(0).toUpperCase() + k.slice(1)}: ${v}</li>`;
            });
            html += `</ul></li>`;
          }
          if (data.specifications) {
            if (data.specifications.sensor) html += `<li><b>Sensor:</b> ${data.specifications.sensor}</li>`;
            if (data.specifications.lens) html += `<li><b>Lens:</b> ${data.specifications.lens}</li>`;
            if (data.specifications.fps) html += `<li><b>FPS:</b> ${data.specifications.fps}</li>`;
            if (data.specifications.compression) html += `<li><b>Compression:</b> ${data.specifications.compression}</li>`;
          }
          infoList.innerHTML = html;
        } catch (e) {
          errorInfo.textContent = 'Error loading camera information.';
          errorInfo.style.display = '';
        }
      }

      
      async function loadRTSPStatus() {
        try {
          const response = await fetch('/admin/rtsp/service/8557');
          if (response.ok) {
            const data = await response.json();
            updateRTSPToggle(data.running);
          } else {
            console.error('Failed to load RTSP status');
            updateRTSPToggle(false);
          }
        } catch (error) {
          console.error('Error loading RTSP status:', error);
          updateRTSPToggle(false);
        }
      }

      function updateRTSPToggle(isEnabled) {
        const toggle = document.getElementById('rtsp-toggle');
        const statusText = document.getElementById('rtsp-status-text');
        
        if (toggle && statusText) {
          toggle.checked = isEnabled;
          statusText.textContent = isEnabled ? 'RTSP Enabled' : 'RTSP Disabled';
          statusText.className = `rtsp-status-text ${isEnabled ? 'enabled' : 'disabled'}`;
        }
      }

      async function toggleRTSPService() {
        const toggle = document.getElementById('rtsp-toggle');
        const statusText = document.getElementById('rtsp-status-text');
        
        if (!toggle || !statusText) return;
        
        
        toggle.disabled = true;
        
        try {
          const response = await fetch('/admin/rtsp/toggle/rtsp_reolink', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            }
          });
          
          if (response.ok) {
            const result = await response.json();
            if (result.success) {
              showNotification('RTSP service toggled successfully', 'success');
              
              const activeTab = document.querySelector('.tab.active');
              if (activeTab) {
                localStorage.setItem('lastActiveTab', activeTab.id);
              }
              
              setTimeout(() => {
                window.location.reload();
              }, 1500);
            } else {
              showNotification(result.message || 'Failed to toggle RTSP service', 'error');
              
              const activeTab = document.querySelector('.tab.active');
              if (activeTab) {
                localStorage.setItem('lastActiveTab', activeTab.id);
              }
              
              setTimeout(() => {
                window.location.reload();
              }, 1500);
            }
          } else {
            showNotification('Failed to toggle RTSP service', 'error');
            
            const activeTab = document.querySelector('.tab.active');
            if (activeTab) {
              localStorage.setItem('lastActiveTab', activeTab.id);
            }
            
            setTimeout(() => {
              window.location.reload();
            }, 1500);
          }
        } catch (error) {
          console.error('Error toggling RTSP service:', error);
          showNotification('Failed to toggle RTSP service', 'error');
          
          const activeTab = document.querySelector('.tab.active');
          if (activeTab) {
            localStorage.setItem('lastActiveTab', activeTab.id);
          }
          
          setTimeout(() => {
            window.location.reload();
          }, 1500);
        } finally {
          toggle.disabled = false;
        }
      }

      
      async function loadONVIFStatus() { 
          try { 
              const response = await fetch("/admin/onvif/service/8088"); 
              if (response.ok) { 
                  const data = await response.json(); 
                  updateONVIFToggle(data.running); 
              } else { 
                  console.error("Failed to load ONVIF status"); 
                  updateONVIFToggle(false); 
              } 
          } catch (error) { 
              console.error("Error loading ONVIF status:", error); 
              updateONVIFToggle(false); 
          } 
      } 
      
      function updateONVIFToggle(isEnabled) { 
          const toggle = document.getElementById("onvif-toggle"); 
          const statusText = document.getElementById("onvif-status-text"); 
          
          if (toggle && statusText) { 
              toggle.checked = isEnabled; 
              statusText.textContent = isEnabled ? "!{__("main.onvifEnabled")}" : "!{__("main.onvifDisabled")}"; 
              statusText.className = `onvif-status-text ${isEnabled ? "enabled" : "disabled"}`; 
          } 
      } 
      
      async function toggleONVIFService() { 
          const toggle = document.getElementById("onvif-toggle"); 
          const statusText = document.getElementById("onvif-status-text"); 
          
          if (!toggle || !statusText) return; 
          
          
          toggle.disabled = true; 
          
          try { 
              const response = await fetch("/admin/onvif/toggle/onvif_reolink_service", { 
                  method: "POST", 
                  headers: { 
                      "Content-Type": "application/json" 
                  } 
              }); 
              
              if (response.ok) { 
                  const result = await response.json(); 
                  if (result.success) { 
                      showNotification("!{__("main.onvifToggleSuccess")}", "success"); 
                      setTimeout(() => { 
                          window.location.reload(); 
                      }, 1500); 
                  } else { 
                      showNotification(result.message || "!{__("main.onvifToggleError")}", "error"); 
                      setTimeout(() => { 
                          window.location.reload(); 
                      }, 1500); 
                  } 
              } else if (response.status === 401) {
                  
                  showNotification('Authentication required. Please log in again.', 'error');
                  setTimeout(() => {
                      window.location.href = '/login';
                  }, 1500);
              } else if (response.status === 403) {
                  
                  showNotification('Admin access required. Please log in as admin.', 'error');
                  setTimeout(() => {
                      window.location.href = '/login';
                  }, 1500);
              } else { 
                  showNotification("!{__("main.onvifToggleError")}", "error"); 
                  setTimeout(() => { 
                      window.location.reload(); 
                  }, 1500); 
              } 
          } catch (error) { 
              console.error("Error toggling ONVIF service:", error); 
              showNotification("!{__("main.onvifToggleError")}", "error"); 
              setTimeout(() => { 
                  window.location.reload(); 
              }, 1500); 
          } finally { 
              toggle.disabled = false; 
          } 
      } 
      
      
      async function checkONVIFAdminStatus() { 
          try { 
              const response = await fetch("/admin/onvif/status"); 
              if (response.ok) { 
                  const onvifControlItem = document.getElementById("onvif-control-item"); 
                  if (onvifControlItem) { 
                      onvifControlItem.style.display = "block"; 
                  } 
                  loadONVIFStatus(); 
              } else if (response.status === 403) { 
                  const onvifControlItem = document.getElementById("onvif-control-item"); 
                  if (onvifControlItem) { 
                      onvifControlItem.style.display = "none"; 
                  } 
              } 
          } catch (error) { 
              console.error("Error checking ONVIF admin status:", error); 
              const onvifControlItem = document.getElementById("onvif-control-item"); 
              if (onvifControlItem) { 
                  onvifControlItem.style.display = "none"; 
              } 
          } 
      }

      function showNotification(message, type) {
        const notification = document.createElement('div');
        notification.style.cssText = `
          position: fixed;
          top: 20px;
          right: 20px;
          padding: 15px 20px;
          border-radius: 5px;
          color: white;
          font-weight: bold;
          z-index: 1000;
          background-color: ${type === 'success' ? '#4caf50' : '#f44336'};
        `;
        notification.textContent = message;
        
        document.body.appendChild(notification);
        
        setTimeout(() => {
          if (notification.parentNode) {
            notification.parentNode.removeChild(notification);
          }
        }, 3000);
      }

      async function checkAdminStatus() {
        try {
          const response = await fetch('/admin/rtsp/status');
          if (response.ok) {
            const rtspControlItem = document.getElementById('rtsp-control-item');
            if (rtspControlItem) {
              rtspControlItem.style.display = 'block';
            }
            loadRTSPStatus();
          } else {
            const rtspControlItem = document.getElementById('rtsp-control-item');
            if (rtspControlItem) {
              rtspControlItem.style.display = 'none';
            }
          }
        } catch (error) {
          console.error('Error checking admin status:', error);
          const rtspControlItem = document.getElementById('rtsp-control-item');
          if (rtspControlItem) {
            rtspControlItem.style.display = 'none';
          }
        }
      }

      document.addEventListener('DOMContentLoaded', function() {
        checkAdminStatus();
                checkONVIFAdminStatus();
        
        const rtspToggle = document.getElementById('rtsp-toggle');
        if (rtspToggle) {
          rtspToggle.addEventListener('change', toggleRTSPService);
                const onvifToggle = document.getElementById("onvif-toggle"); 
                if (onvifToggle) { 
                    onvifToggle.addEventListener("change", toggleONVIFService); 
                }
        }
        
        const lastActiveTab = localStorage.getItem('lastActiveTab');
        if (lastActiveTab) {
          localStorage.removeItem('lastActiveTab');
          if (lastActiveTab === 'info-tab') {
            document.getElementById('info-tab').click();
          }
        }
      }); 
