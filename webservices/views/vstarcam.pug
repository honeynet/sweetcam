doctype html
html(lang="en")
  head
    meta(charset='UTF-8')
    title #{model}
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css")
    style.
      body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background: #222;
        margin: 0;
        color: #fff;
        min-height: 100vh;
      }
      .main-layout {
        display: flex;
        flex-direction: row;
        height: 100vh;
        width: 100vw;
      }
      .vstarcam-image-area {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        background: #181d23;
        flex: 1;
      }
      .vstarcam-player {
        background: #000;
        border-radius: 10px;
        width: 100%;
        height: 100%;
        max-width: 900px;
        max-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      #container {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #000;
        overflow: hidden;
        position: relative;
        border-radius: 8px;
      }
      #imageViewer {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        overflow: hidden;
      }
      .no-images {
        color: #b0b8c1;
        font-size: 1.2em;
      }

      .vstarcam-panel {
        width: 340px;
        background: #fff;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 24px 18px;
        border: 2px solid #e0e0e0;
        border-radius: 24px;
        height: 90vh;
        position: relative;
      }

      .vstarcam-logo {
        width: 200px;
        margin-bottom: 5px;
      }

      .joystick {
        position: relative;
        width: 120px;
        height: 120px;
        border-radius: 50%;
        background: radial-gradient(circle at center, #1e90ff, #0050a0);
        box-shadow: inset 0 0 12px #002244;
        border: 3px solid #fff;
        margin-top: 16px;
        margin-bottom: 24px;
      }

      .joystick-inner {
        position: absolute;
        width: 40px;
        height: 40px;
        background: #fff;
        border-radius: 50%;
        top: 40px;
        left: 40px;
        cursor: grab;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.4);
      }

      .camera-info {
        margin-top: 12px;
        width: 100%;
        color: #222;
        font-size: 1em;
        background: #fff;
        border-radius: 8px;
        padding: 10px 12px;
        box-shadow: 0 1px 4px rgba(0,0,0,0.04);
        border: 1px solid #e0e0e0;
      }

      .camera-info-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 6px;
      }

      .camera-info-label {
        color: #888;
      }

      .logo-underline {
        width: 80%;
        height: 2px;
        background: #111;
        margin: 0 auto 18px auto;
        border-radius: 1px;
      }

      .camera-info-box {
        width: 100%;
        background: #f6f6f6;
        border-radius: 10px;
        padding: 14px 10px 10px 10px;
        margin-top: 10px;
        box-shadow: 0 1px 4px rgba(0,0,0,0.04);
        border: 1px solid #e0e0e0;
      }

      .info-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 8px;
        font-size: 1em;
      }

      .label {
        color: #222;
        font-weight: 500;
      }

      .value {
        color: #222;
        font-weight: 600;
        min-width: 80px;
        text-align: right;
      }

      .camera-info-box select.value {
        min-width: 80px;
        padding: 2px 6px;
        border-radius: 4px;
        border: 1px solid #888;
        background: #fff;
        color: #222;
        font-size: 1em;
      }

      .settings-btn-rect {
        position: absolute;
        bottom: 70px;
        left: 50%;
        transform: translateX(-50%);
        background:rgb(255, 255, 255);
        border: 1.5px solid #888;
        border-radius: 6px;
        width: 350px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        box-shadow: 0 2px 8px rgba(0,0,0,0.10);
        transition: background 0.2s;
        font-size: 1em;
        color: #222;
        gap: 8px;
      }

      .settings-btn-rect:hover {
        background: #d6d6d6;
      }

      .settings-modal {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(0,0,0,0.45);
        z-index: 1000;
        align-items: center;
        justify-content: center;
      }

      .settings-modal.active {
        display: flex;
      }

      .settings-modal-content {
        background: #fff;
        color: #222;
        border-radius: 12px;
        padding: 32px 28px 24px 28px;
        min-width: 320px;
        max-width: 90vw;
        max-height: 80vh;
        box-shadow: 0 4px 32px rgba(0,0,0,0.18);
        position: relative;
        display: flex;
        flex-direction: column;
      }

      .settings-modal-close {
        position: absolute;
        top: 12px;
        right: 18px;
        background: none;
        border: none;
        font-size: 2em;
        color: #888;
        cursor: pointer;
      }

      .settings-modal-close:hover {
        color: #222;
      }

      .settings-modal-title {
        font-size: 1.3em;
        font-weight: bold;
        margin-bottom: 18px;
        color: #1e90ff;
      }

      .settings-modal-list {
        list-style: none;
        padding: 0;
        margin: 0;
      }
      
      .settings-modal-scrollable {
        flex: 1;
        overflow-y: auto;
        padding-right: 8px;
        margin-right: -8px;
      }
      
      .settings-modal-scrollable::-webkit-scrollbar {
        width: 8px;
      }
      
      .settings-modal-scrollable::-webkit-scrollbar-track {
        background: #f1f1f1;
        border-radius: 4px;
      }
      
      .settings-modal-scrollable::-webkit-scrollbar-thumb {
        background: #c1c1c1;
        border-radius: 4px;
      }
      
      .settings-modal-scrollable::-webkit-scrollbar-thumb:hover {
        background: #a8a8a8;
      }

      .settings-modal-list li {
        margin-bottom: 8px;
      }

      .settings-modal-list ul {
        margin: 0 0 0 18px;
      }
       .logout-btn-rect {
        position: absolute;
        bottom: 18px;
        left: 50%;
        transform: translateX(-50%);
        background:rgb(255, 255, 255);
        border: 1.5px solid #888;
        border-radius: 6px;
        width: 350px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        box-shadow: 0 2px 8px rgba(0,0,0,0.10);
        transition: background 0.2s;
        font-size: 1em;
        color: #000;
        gap: 8px;
        text-decoration: none;
      }

      .logout-btn-rect:hover {
        background: #002244;
      }
      .rtsp-control-item {
        margin-top: 20px;
        padding: 15px;
        background: #f8f9fa;
        border-radius: 8px;
        border-left: 4px solid #1e90ff;
      }
      .rtsp-toggle-container {
        display: flex;
        align-items: center;
        gap: 15px;
      }
      .rtsp-toggle {
        position: relative;
        display: inline-block;
        width: 60px;
        height: 34px;
      }
      .rtsp-toggle-input {
        opacity: 0;
        width: 0;
        height: 0;
      }
      .rtsp-toggle-slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: #ccc;
        transition: .4s;
        border-radius: 34px;
      }
      .rtsp-toggle-slider:before {
        position: absolute;
        content: "";
        height: 26px;
        width: 26px;
        left: 4px;
        bottom: 4px;
        background-color: white;
        transition: .4s;
        border-radius: 50%;
      }
      .rtsp-toggle-input:checked + .rtsp-toggle-slider {
        background-color: #1e90ff;
      }
      .rtsp-toggle-input:checked + .rtsp-toggle-slider:before {
        transform: translateX(26px);
      }
      .rtsp-toggle-input:disabled + .rtsp-toggle-slider {
        opacity: 0.6;
        cursor: not-allowed;
      }
      .rtsp-status-text {
        font-weight: 600;
        font-size: 14px;
      }
      .rtsp-status-text.enabled {
        color: #4caf50;
      }
      .rtsp-status-text.disabled {
        color: #f44336;
      } 
            
