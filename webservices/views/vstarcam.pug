  body
    .main-layout
      .vstarcam-image-area
        .vstarcam-player
          #container
            #imageViewer
              .no-images#noImages(style="display: none;") No images found
      .vstarcam-panel
        img.vstarcam-logo(src=brandImagePath, alt=brand)
        .logo-underline
        .joystick
          .joystick-inner#joystickKnob
        .camera-info-box
          .info-row
            span.label= __('main.model')
            span.value #{model}
          .info-row
            span.label= __('main.resolution')
            span.value #{resolution}
          .info-row
            span.label= __('main.mode')
            select.value(name="mode")
              option 50 Hz
              option 60 Hz
          .info-row
            span.label= __('main.brightness')
            select.value(name="brightness")
              option 4
              option 5
              option 6(selected)
              option 7
              option 8
          .info-row
            span.label= __('main.contrast')
            select.value(name="contrast")
              option 2
              option 3
              option 4(selected)
              option 5
              option 6
          .info-row
            span.label= __('main.maxfps')
            select.value(name="maxfps")
              option full speed
              option 15 fps
              option 10 fps
          .info-row
            span.label= __('main.preset')
            span.value
              button.preset-btn= __('main.call')
              button.preset-btn= __('main.set')
        .preset-bar
        button.settings-btn-rect(type="button" id="settingsBtn" title="Settings")
          i.fas.fa-cog
          span= __('main.settings')
        a.logout-btn-rect(href="/logout")
          i.fas.fa-sign-out-alt
          span= __('main.logout')
        .settings-modal#settingsModal
          .settings-modal-content
            button.settings-modal-close(type="button" id="settingsModalClose" aria-label="Close") &times;
            div.settings-modal-title#settingsModalTitle #{__('main.settings')}
            .settings-modal-scrollable
              ul.settings-modal-list#settingsModalList
              div#errorSettingsInfo(style="color:#ff4d4d; margin-top:12px; display:none;")
              .rtsp-control-item#rtsp-control-item(style="display: none;")
                h3(style='color:#1e90ff; margin-top:0; margin-bottom:15px;') RTSP Service
                .rtsp-toggle-container
                  label.rtsp-toggle
                    input.rtsp-toggle-input(type="checkbox" id="rtsp-toggle")
                    span.rtsp-toggle-slider
                  span.rtsp-status-text#rtsp-status-text RTSP Disabled
              .onvif-control-item#onvif-control-item(style="display: none;")
                h3(style='color:#1e90ff; margin-top:0; margin-bottom:15px;') #{__("main.onvifService")}
                .onvif-toggle-container
                  label.onvif-toggle
                    input.onvif-toggle-input(type="checkbox" id="onvif-toggle")
                    span.onvif-toggle-slider
                  span.onvif-status-text#onvif-status-text= __('main.onvifDisabled')
    script(src='https://code.jquery.com/jquery-3.6.0.min.js')
    script(src='https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js')
    script.
      let currentImage = null;
      let currentX = 0;
      let currentY = 0;
      let imageWidth = 0;
      let imageHeight = 0;
      let containerWidth = 0;
      let containerHeight = 0;
      const moveStep = 30;

      const labels = {
        model: '!{__('main.model')}',
        type: '!{__('main.type')}',
        resolution: '!{__('main.resolution')}',
        sensor: '!{__('main.sensor')}',
        lens: '!{__('main.lens')}',
        fps: '!{__('main.fps')}',
        compression: '!{__('main.compression')}',
        error: '!{__('main.errorLoadingSystemInfo')}'
      };

      function loadImage() {
        const xhr = new XMLHttpRequest();
        xhr.open('GET', '/api/images', true);
        xhr.onreadystatechange = function () {
          if (xhr.readyState === 4 && xhr.status === 200) {
              try {
                const images = JSON.parse(xhr.responseText);
              if (images.length > 0) displayImage(images[0]);
              else document.getElementById('noImages').style.display = 'block';
            } catch {
              document.getElementById('noImages').style.display = 'block';
            }
          }
        };
        xhr.send();
      }

      function displayImage(imageSrc) {
        const imageViewer = document.getElementById('imageViewer');
        imageViewer.innerHTML = '';
        const img = document.createElement('img');
        img.src = imageSrc;
        img.style.position = 'absolute';
        img.style.top = '0';
        img.style.left = '0';
        img.style.maxWidth = 'none';
        img.style.maxHeight = 'none';
        img.draggable = false;
        img.onload = function () {
          imageWidth = this.naturalWidth;
          imageHeight = this.naturalHeight;
          containerWidth = imageViewer.clientWidth;
          containerHeight = imageViewer.clientHeight;
          currentX = Math.max(0, (imageWidth - containerWidth) / 2);
          currentY = Math.max(0, (imageHeight - containerHeight) / 2);
          updateImagePosition();
        };
        imageViewer.appendChild(img);
        currentImage = img;
      }

      function updateImagePosition() {
        if (!currentImage) return;
        const maxX = Math.max(0, imageWidth - containerWidth);
        const maxY = Math.max(0, imageHeight - containerHeight);
        currentX = Math.max(0, Math.min(currentX, maxX));
        currentY = Math.max(0, Math.min(currentY, maxY));
        currentImage.style.transform = `translate(-${currentX}px, -${currentY}px)`;
      }

      function moveCamera(dx, dy) {
        currentX += dx;
        currentY += dy;
          updateImagePosition();
      }

      let moveInterval = null;
      let moveDirection = { x: 0, y: 0 };
      const moveDelay = 30; 
      const threshold = 5; 

      function startContinuousMove(dx, dy) {
        if (moveInterval) clearInterval(moveInterval);
        moveDirection = { x: dx, y: dy };
        moveInterval = setInterval(() => {
          moveCamera(moveDirection.x, moveDirection.y);
        }, moveDelay);
      }

      function stopContinuousMove() {
        if (moveInterval) clearInterval(moveInterval);
        moveInterval = null;
        moveDirection = { x: 0, y: 0 };
      }

      document.addEventListener('DOMContentLoaded', function () {
        const knob = document.getElementById('joystickKnob');
        const joystick = knob.parentElement;
        let dragging = false;
        let origin = { x: 0, y: 0 };
        let lastDx = 0, lastDy = 0;
        const maxRadius = 40; 
        const maxPan = 60; 

        knob.addEventListener('mousedown', (e) => {
          dragging = true;
          origin.x = e.clientX;
          origin.y = e.clientY;
          lastDx = 0;
          lastDy = 0;
          e.preventDefault();
        });

        document.addEventListener('mousemove', (e) => {
          if (!dragging) return;
          let dx = e.clientX - origin.x;
          let dy = e.clientY - origin.y;
          
          const dist = Math.sqrt(dx*dx + dy*dy);
          if (dist > maxRadius) {
            dx = dx * maxRadius / dist;
            dy = dy * maxRadius / dist;
          }
          knob.style.transform = `translate(${dx}px, ${dy}px)`;
          
          if (Math.abs(dx) > threshold || Math.abs(dy) > threshold) {
            
            let dirX = dx === 0 ? 0 : dx / Math.abs(dx);
            let dirY = dy === 0 ? 0 : dy / Math.abs(dy);
            startContinuousMove(Math.round(dirX * moveStep), Math.round(dirY * moveStep));
          } else {
            stopContinuousMove();
          }
        });

        document.addEventListener('mouseup', (e) => {
          if (!dragging) return;
          dragging = false;
          knob.style.transform = 'translate(0, 0)';
          lastDx = 0;
          lastDy = 0;
          stopContinuousMove();
        });

        
        document.addEventListener('keydown', (e) => {
          switch (e.key.toLowerCase()) {
            case 'arrowup':
            case 'w': moveCamera(0, -moveStep); break;
            case 'arrowdown':
            case 's': moveCamera(0, moveStep); break;
            case 'arrowleft':
            case 'a': moveCamera(-moveStep, 0); break;
            case 'arrowright':
            case 'd': moveCamera(moveStep, 0); break;
          }
        });

        loadImage();
      });

      document.addEventListener('DOMContentLoaded', function() {
        const settingsBtn = document.getElementById('settingsBtn');
        const settingsModal = document.getElementById('settingsModal');
        const settingsModalClose = document.getElementById('settingsModalClose');
        const settingsModalTitle = document.getElementById('settingsModalTitle');
        const settingsModalList = document.getElementById('settingsModalList');
        const errorSettingsInfo = document.getElementById('errorSettingsInfo');
        function closeModal() {
          settingsModal.classList.remove('active');
        }
        settingsBtn.addEventListener('click', async function() {
          settingsModal.classList.add('active');
          settingsModalTitle.textContent = labels.settings || 'Settings';
          settingsModalList.innerHTML = '';
          errorSettingsInfo.style.display = 'none';
          try {
            const res = await fetch('/config/vstarcam.json');
            if (!res.ok) throw new Error('Failed to load');
            const data = await res.json();
            let html = '';
            if (data.model) html += `<li><b>${labels.model}:</b> ${data.model}</li>`;
            if (data.type) html += `<li><b>${labels.type}:</b> ${data.type}</li>`;
            if (data.resolution) html += `<li><b>${labels.resolution}:</b> ${data.resolution}</li>`;
            if (data.specifications) {
              if (data.specifications.sensor) html += `<li><b>${labels.sensor}:</b> ${data.specifications.sensor}</li>`;
              if (data.specifications.lens) html += `<li><b>${labels.lens}:</b> ${data.specifications.lens}</li>`;
              if (data.specifications.fps) html += `<li><b>${labels.fps}:</b> ${data.specifications.fps}</li>`;
              if (data.specifications.compression) html += `<li><b>${labels.compression}:</b> ${data.specifications.compression}</li>`;
            }
            Object.entries(data).forEach(([k,v]) => {
              if (["features","specifications","brand","model","type","resolution","brandImagePath","brandImageWidth"].includes(k)) return;
              html += `<li><b>${k}:</b> ${v}</li>`;
            });
            settingsModalList.innerHTML = html;
          } catch (e) {
            errorSettingsInfo.textContent = labels.error;
            errorSettingsInfo.style.display = '';
          }
        });
        settingsModalClose.addEventListener('click', closeModal);
        settingsModal.addEventListener('click', function(e) {
          if (e.target === settingsModal) closeModal();
        });
      });

      
      async function loadRTSPStatus() {
        // Only load RTSP status if user is an admin
        if (!#{isAdmin}) {
          return;
        }
        
        try {
          const response = await fetch('/admin/rtsp/service/8559');
          if (response.ok) {
            const data = await response.json();
            updateRTSPToggle(data.running);
          } else {
            console.error('Failed to load RTSP status');
            updateRTSPToggle(false);
          }
        } catch (error) {
          console.error('Error loading RTSP status:', error);
          updateRTSPToggle(false);
        }
      }

      function updateRTSPToggle(isEnabled) {
        const toggle = document.getElementById('rtsp-toggle');
        const statusText = document.getElementById('rtsp-status-text');
        
        if (toggle && statusText) {
          toggle.checked = isEnabled;
          statusText.textContent = isEnabled ? 'RTSP Enabled' : 'RTSP Disabled';
          statusText.className = `rtsp-status-text ${isEnabled ? 'enabled' : 'disabled'}`;
        }
      }

      async function toggleRTSPService() {
        // Only allow RTSP toggle if user is an admin
        if (!#{isAdmin}) {
          showNotification('Admin access required. Please log in as admin.', 'error');
          return;
        }
        
        const toggle = document.getElementById('rtsp-toggle');
        const statusText = document.getElementById('rtsp-status-text');
        
        if (!toggle || !statusText) return;
        
        
        const currentState = toggle.checked;
        const newState = !currentState;
        
        
        toggle.checked = newState;
        statusText.textContent = newState ? 'RTSP Enabled' : 'RTSP Disabled';
        statusText.className = `rtsp-status-text ${newState ? 'enabled' : 'disabled'}`;
        
        
        toggle.disabled = true;
        
        try {
          const response = await fetch('/admin/rtsp/toggle/rtsp_vstarcam', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            }
          });
          
          if (response.ok) {
            const result = await response.json();
            if (result.success) {
              
              showNotification('RTSP service toggled successfully', 'success');
              
              await loadRTSPStatus();
            } else {
              
              showNotification(result.message || 'Failed to toggle RTSP service', 'error');
              
              await loadRTSPStatus();
            }
          } else if (response.status === 401) {
            
            showNotification('Authentication required. Please log in again.', 'error');
            await loadRTSPStatus();
            setTimeout(() => {
              window.location.href = '/login';
            }, 1500);
          } else if (response.status === 403) {
            
            showNotification('Admin access required. Please log in as admin.', 'error');
            await loadRTSPStatus();
            setTimeout(() => {
              window.location.href = '/login';
            }, 1500);
          } else {
            
            showNotification('Failed to toggle RTSP service', 'error');
            await loadRTSPStatus();
          }
        } catch (error) {
          console.error('Error toggling RTSP service:', error);
          showNotification('Failed to toggle RTSP service', 'error');
          
          await loadRTSPStatus();
        } finally {
          
          toggle.disabled = false;
        }
      }

      
      async function loadONVIFStatus() { 
          // Only load ONVIF status if user is an admin
          if (!#{isAdmin}) {
              return;
          }
          
          try { 
              const response = await fetch("/admin/onvif/service/8090"); 
              if (response.ok) { 
                  const data = await response.json(); 
                  updateONVIFToggle(data.running); 
              } else { 
                  console.error("Failed to load ONVIF status"); 
                  updateONVIFToggle(false); 
              } 
          } catch (error) { 
              console.error("Error loading ONVIF status:", error); 
              updateONVIFToggle(false); 
          } 
      } 
      
      function updateONVIFToggle(isEnabled) { 
          const toggle = document.getElementById("onvif-toggle"); 
          const statusText = document.getElementById("onvif-status-text"); 
          
          if (toggle && statusText) { 
              toggle.checked = isEnabled; 
              statusText.textContent = isEnabled ? "!{__("main.onvifEnabled")}" : "!{__("main.onvifDisabled")}"; 
              statusText.className = `onvif-status-text ${isEnabled ? "enabled" : "disabled"}`; 
          } 
      } 
      
      async function toggleONVIFService() { 
          // Only allow ONVIF toggle if user is an admin
          if (!#{isAdmin}) {
              showNotification('Admin access required. Please log in as admin.', 'error');
              return;
          }
          
          const toggle = document.getElementById("onvif-toggle"); 
          const statusText = document.getElementById("onvif-status-text"); 
          
          if (!toggle || !statusText) return; 
          
          
          const currentState = toggle.checked;
          const newState = !currentState;
          
          
          toggle.checked = newState;
          statusText.textContent = newState ? "!{__("main.onvifEnabled")}" : "!{__("main.onvifDisabled")}";
          statusText.className = `onvif-status-text ${newState ? "enabled" : "disabled"}`;
          
          
          toggle.disabled = true; 
          
          try { 
              const response = await fetch("/admin/onvif/toggle/onvif_vstarcam_service", { 
                  method: "POST", 
                  headers: { 
                      "Content-Type": "application/json" 
                  } 
              }); 
              
              if (response.ok) { 
                  const result = await response.json(); 
                                          if (result.success) { 
                            
                            showNotification("!{__("main.onvifToggleSuccess")}", "success");
                            
                            await loadONVIFStatus();
                        } else { 
                      
                      showNotification(result.message || "!{__("main.onvifToggleError")}", "error");
                      
                      await loadONVIFStatus();
                  } 
              } else if (response.status === 401) {
                  
                  showNotification('Authentication required. Please log in again.', 'error');
                  await loadONVIFStatus();
                  setTimeout(() => {
                      window.location.href = '/login';
                  }, 1500);
              } else if (response.status === 403) {
                  
                  showNotification('Admin access required. Please log in as admin.', 'error');
                  await loadONVIFStatus();
                  setTimeout(() => {
                      window.location.href = '/login';
                  }, 1500);
              } else { 
                  
                  showNotification("!{__("main.onvifToggleError")}", "error");
                  await loadONVIFStatus();
              } 
          } catch (error) { 
              console.error("Error toggling ONVIF service:", error); 
              showNotification("!{__("main.onvifToggleError")}", "error");
              
              await loadONVIFStatus();
          } finally { 
              
              toggle.disabled = false; 
          } 
      } 
      
      
      async function checkONVIFAdminStatus() { 
          // Only check ONVIF admin status if user is an admin
          if (!#{isAdmin}) {
              const onvifControlItem = document.getElementById("onvif-control-item"); 
              if (onvifControlItem) { 
                  onvifControlItem.style.display = "none"; 
              } 
              return;
          }
          
          try { 
              const response = await fetch("/admin/onvif/status"); 
              if (response.ok) { 
                  const onvifControlItem = document.getElementById("onvif-control-item"); 
                  if (onvifControlItem) { 
                      onvifControlItem.style.display = "block"; 
                  } 
                  loadONVIFStatus(); 
              } else if (response.status === 403) { 
                  const onvifControlItem = document.getElementById("onvif-control-item"); 
                  if (onvifControlItem) { 
                      onvifControlItem.style.display = "none"; 
                  } 
              } 
          } catch (error) { 
              console.error("Error checking ONVIF admin status:", error); 
              const onvifControlItem = document.getElementById("onvif-control-item"); 
              if (onvifControlItem) { 
                  onvifControlItem.style.display = "none"; 
              } 
          } 
      }

      function showNotification(message, type) {
        const notification = document.createElement('div');
        notification.style.cssText = `
          position: fixed;
          top: 20px;
          right: 20px;
          padding: 15px 20px;
          border-radius: 5px;
          color: white;
          font-weight: bold;
          z-index: 1000;
          background-color: ${type === 'success' ? '#4caf50' : '#f44336'};
        `;
        notification.textContent = message;
        
        document.body.appendChild(notification);
        
        setTimeout(() => {
          if (notification.parentNode) {
            notification.parentNode.removeChild(notification);
          }
        }, 3000);
      }

      async function checkAdminStatus() {
        // Only check admin status if user is an admin
        if (!#{isAdmin}) {
          const rtspControlItem = document.getElementById('rtsp-control-item');
          if (rtspControlItem) {
            rtspControlItem.style.display = 'none';
          }
          return;
        }
        
        try {
          const response = await fetch('/admin/rtsp/status');
          if (response.ok) {
            const rtspControlItem = document.getElementById('rtsp-control-item');
            if (rtspControlItem) {
              rtspControlItem.style.display = 'block';
            }
            loadRTSPStatus();
          } else {
            const rtspControlItem = document.getElementById('rtsp-control-item');
            if (rtspControlItem) {
              rtspControlItem.style.display = 'none';
            }
          }
        } catch (error) {
          console.error('Error checking admin status:', error);
          const rtspControlItem = document.getElementById('rtsp-control-item');
          if (rtspControlItem) {
            rtspControlItem.style.display = 'none';
          }
        }
      }

      document.addEventListener('DOMContentLoaded', function() {
        checkAdminStatus();
                checkONVIFAdminStatus();
        
        const rtspToggle = document.getElementById('rtsp-toggle');
        if (rtspToggle) {
          rtspToggle.addEventListener('change', toggleRTSPService);
                const onvifToggle = document.getElementById("onvif-toggle"); 
                if (onvifToggle) { 
                    onvifToggle.addEventListener("change", toggleONVIFService); 
                }
        }
        
        const lastModalState = localStorage.getItem('lastModalState');
        if (lastModalState === 'open') {
          localStorage.removeItem('lastModalState');
          setTimeout(() => {
            document.getElementById('settingsBtn').click();
          }, 500);
        }
      });
