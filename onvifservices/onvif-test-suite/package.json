{
  "name": "onvif-test-suite",
  "version": "1.0.0",
  "description": "Comprehensive test suite for ONVIF honeypot services using Jest",
  "main": "onvif.test.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:verbose": "jest --verbose",
    "test:port": "jest port.test.js",
    "test:database": "jest database.test.js",
    "test:onvif": "jest onvif.test.js",
    "test:all": "jest --testPathPattern='.*\\.test\\.js'"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "mysql2": "^3.6.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.0"
  },
  "keywords": [
    "onvif",
    "honeypot",
    "testing",
    "jest",
    "security",
    "camera",
    "network"
  ],
  "author": "ONVIF Test Suite",
  "license": "MIT"
} 